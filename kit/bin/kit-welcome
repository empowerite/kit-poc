#!/usr/bin/env bash
# kit-welcome - walks a newcomer through what kit needs, the toolchains, setup, and the workflow (kit verb: help)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit welcome [--text]
#   kit welcome --checks [--json | --jq] [--folder=<path> | --machine] [--progress]
#   kit welcome --fix=<check> [--folder=<path> | --machine]
#   kit welcome --keep=<check> [--json]
#   kit welcome --unkeep=<check> [--json]
#
# A guide for your first hour with kit, in five steps:
#
#   1. Introduction: what kit is, who it is for, and what it solves.
#   2. Toolchains: bash, git, jq, and yq, which kit runs on, and the machine's package manager, one check each.
#   3. Setup: your forge logins, then each folder of the workspace, its desk and its worktrees. Each folder is checked for
#      kit installed at the version its kit.yml declares, .kit/ in place, the hooks, its tool manager, its linters, and
#      kit check.
#   4. Customize: the settings teams change first, packages, and the docs.
#   5. Terms: the words kit uses, by topic, each with a command that shows it.
#
# kit's nine screens, from Flow, the trip from an issue to a release, to Packages, are a tutorial that ships with the kit:
# kit tutorials applications.
#
# Steps 2 and 3 hold checks. On a terminal, kit welcome opens kittui's welcome screen, on the introduction while the
# checks run, and it stays there when they answer; a step with failed checks counts them in red on the bar. Each
# failed check there shows its fix. c, or a click on its ⧉, copies it. r, or a click on its ▶️, has kit run it and
# check again, where kit runs the fix. Without a terminal, or with --text, it prints each step's page with its checks
# under it, then a list of what is left. It runs nothing: only --fix runs a fix, and only the one named.
#
# On a terminal, setup also judges the terminal kit runs in. kit asks it what it does, reads its settings where it knows
# the terminal, and names each setting that makes kittui slower or worse. The fixes are yours to make in the terminal's
# settings, so kit shows them and never runs them, and --keep= keeps a finding as it is. Every finding, for every terminal:
# https://github.com/empowerite/kit/blob/main/docs/terminals.md
#
# A check is the machine's, judged once, or a folder's, judged in each folder of the workspace. The workspace is the one
# kit workspaces --current names, or kit --workspace=<workspace> welcome: for a repository, its desk, then each of its
# worktrees; for a group, every member's desk and worktrees, in the group's order. --workspace=none names no group, as for
# kit flow, so it is the repository here. With no workspace, only the machine checks run: outside a repository with no
# group used, or with --workspace=none there. Each folder is judged on its own, as each may have a kit.yml or none, and pin
# its own kit: kit check runs there on the release it pins.
#
# A missing tool's fix comes from the toolchains kit found, and never from one it assumes. The checks' JSON is in
# docs/apps.md.
#
# Arguments:
#   --text            prints the guide, even on a terminal
#   --checks          prints the checks alone, one line each
#   --json            the checks as a JSON array; with --keep= or --unkeep=, the check as it now is, one JSON object,
#                     or null where kit did not ask the terminal
#   --jq              the same JSON, formatted by jq for a person
#   --fix=<check>     runs one check's fix, then checks again
#   --keep=<check>    keeps a terminal's finding as it is: it holds from now on, in the profile it was judged in;
#                     then says the check as it now is
#   --unkeep=<check>  undoes a keep, so the finding is judged again, and says it
#   --folder=<path>   the folder whose working tree holds <path>: --checks prints its checks alone, and --fix runs a
#                     folder's check there; with none, --fix runs it in the repository here
#   --machine         judges the machine alone, as kittui's guide does, which depends on no repository and no workspace:
#                     no folder is checked, and the forge checks are github.com's, not those of a workspace's hosts;
#                     with --checks or --fix, and not with --folder=
#   --progress        with --checks, says on stderr what is being checked as it goes, for kittui to show while the
#                     checks run
#   <check>           a check's id, as --checks --json names it: tool-yq, toolchain-project
#
# Exits 0 when every check holds, and after --checks prints them, 1 when a check fails or the workspace file cannot be
# read, and 2 on a usage error. A fix that leaves its check failing exits 1. A usage error also includes:
#   - a workspace or a --folder= kit cannot find
#   - --fix for a check that is unknown, holds already, or has no fix
#   - a machine check given --folder=, or a folder's check named outside a repository without one
#
# see: modules/bash/welcome.sh, modules/bash/workspaces.sh, modules/bash/tui.sh, docs/apps.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use welcome tui terminal
guard:arguments welcome "$@" || exit $?

folder=${syntax_options[--folder]:-}
if [[ -n "${syntax_options[--folder]+x}" && -z "${folder}" ]]
then
  error "--folder= needs a folder: --folder=<path>; see: kit help welcome"
  exit 2
fi

# The terminal is asked here, in the main shell, where stdin and stdout are still the person's terminal, and what it
# answered goes to the checks, and to kittui, in KIT_TERMINAL_PROBES. A fix asks it nothing, as kit never runs a
# terminal's fix.
[[ -n "${syntax_options[--fix]+x}" ]] || terminal:export-probes

for action in keep unkeep
do
  if [[ -n "${syntax_options[--${action}]+x}" ]]
  then
    check=$(welcome:keep "${action}" "${syntax_options[--${action}]}") || exit $?
    if [[ -n "${syntax_options[--json]+x}" ]]
    then
      printf '%s\n' "${check:-null}"
    elif [[ -n "${check}" ]]
    then
      # shellcheck disable=SC2034  # read by modules/bash/welcome.sh
      welcome_fold=false
      welcome:show "${check}"
    fi
    exit 0
  fi
done

if [[ -n "${syntax_options[--machine]+x}" ]]
then
  # shellcheck disable=SC2034  # read by modules/bash/welcome.sh
  welcome_machine=true
fi

if [[ -n "${syntax_options[--fix]+x}" ]]
then
  welcome:fix "${syntax_options[--fix]}" "${folder}" && status=0 || status=$?
  exit "${status}"
fi

if [[ -n "${folder}" && -z "${syntax_options[--checks]+x}" ]]
then
  error "--folder= goes with --checks or --fix; see: kit help welcome"
  exit 2
fi

# welcome:find-folders finds the folders to judge, in the main shell, so a workspace or a folder kit cannot find stops
# the guide with its line: the one --folder= names, else the workspace's.
welcome:find-folders() {
  if [[ -n "${folder}" ]]
  then
    welcome:folder "${folder}"
  else
    welcome:folders
  fi
}

if [[ -n "${syntax_options[--checks]+x}" ]]
then
  welcome:find-folders || exit $?
  # shellcheck disable=SC2034  # read by modules/bash/welcome.sh
  [[ -z "${syntax_options[--progress]+x}" ]] || welcome_progress=true
  readarray -t checks < <(welcome:checks ${folder:+--folders})
  if [[ -n "${syntax_options[--json]+x}" ]]
  then
    printf '%s\n' "${checks[@]}" | jq --slurp --compact-output .
  elif [[ -n "${syntax_options[--jq]+x}" ]]
  then
    printf '%s\n' "${checks[@]}" | jq --slurp .
  else
    welcome:show-all "${checks[@]}"
  fi
  exit 0
fi

# On a terminal, with no form chosen, the guide is kittui's, which runs this kit over the machine alone, as --machine
# names it, whatever workspace kit --workspace= named. Without a kittui, the guide prints, as it does without a terminal.
if [[ -z "${syntax_options[--text]+x}" && -t 0 && -t 1 && -t 2 ]] && tui:binary --probe >/dev/null
then
  tui:exec welcome
fi

welcome:find-folders || exit $?
readarray -t pages < <(welcome:pages)
readarray -t checks < <(welcome:checks)
# Each page, with its step's checks under it, then what is left. A check whose step has no page comes last.
declare -A shown=()
for page in "${pages[@]}"
do
  welcome:page "${page}"
  step=$(welcome:page-step "${page}")
  readarray -t mine < <(printf '%s\n' "${checks[@]}" \
    | jq --compact-output --arg step "${step}" 'select(.step == $step)')
  if (( ${#mine[@]} ))
  then
    printf '\n'
    welcome:show-all "${mine[@]}"
  fi
  shown[${step}]=1
  printf '\n'
done
readarray -t rest < <(printf '%s\n' "${checks[@]}" \
  | jq --compact-output --args 'select(.step | IN($ARGS.positional[]) | not)' -- "${!shown[@]}")
if (( ${#rest[@]} ))
then
  welcome:show-all "${rest[@]}"
  printf '\n'
fi
welcome:left "${checks[@]}"
printf '%s\n' "${checks[@]}" | jq --slurp --exit-status 'all(.ok)' >/dev/null

# ----------------------------------------------------------------------------------------------------------------------
