#!/usr/bin/env bash
# kit-context - prints the rules that govern a file (kit verb: files)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit context <path>… [--json | --jq]
#   kit context --claude
#
# Prints the path of each rule that governs the given paths, once each. The rules come first, then the styles, of
# the path's kinds. Then come the rules of the kinds those kinds embed, so a justfile brings the bash rule. Each
# request is logged to kit/context.log in git's common directory.
#
# The kinds and rules of a checkout govern the files in it. For a path in another checkout of the repository, which
# is the desk or a worktree, kit context answers from that checkout, so a file in a worktree gets the same answer
# from the desk and from the worktree. It prints each of those rules with the checkout's path in front, such as
# worktrees/7-fix-the-thing/.kit/rules/bash.md, so that the rule opens from where you asked.
#
# Runs as Claude Code's PreToolUse hook. It reads the hook's input on stdin, and answers with the rules that govern
# the file the tool is about to write, as additional context. In a clone you have not trusted, where kit reads no
# rule, the hook says so in the same form: that the trust is the person's to give, and the command the person runs.
# The harness shows the agent nothing of a line on stderr, and the hook trusts nothing itself.
#
# Arguments:
#   <path>…    the files, relative to the current directory; need not exist
#   --json     one JSON object per path: path, kinds, and rules
#   --jq       the same JSON, formatted by jq for a person
#   --claude   runs as Claude Code's PreToolUse hook
#
# Exits 0 when the rules are printed, 1 when a kind under .kit/kinds/ cannot be read, as one with no name: or one
# defined twice, and 2 on a usage error.
#
# see: modules/bash/context.sh, docs/context.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
# The hook's harness reads its answer as JSON on stdout, so in a clone you have not trusted the hook answers there,
# and reads nothing of the clone; every other form is refused, as kit:enter refuses it.
trust=0
kit:trusted-at . || trust=$?
if [[ "${1:-}" == --claude ]] && (( trust != 0 ))
then
  kit:enter --any-clone
  use context trust
  guard:arguments context "$@" || exit $?
  context:claude-untrusted "${trust}"
  exit 0
fi
kit:enter
use context materialize
guard:arguments context "$@" || exit $?
materialize:hydrate

case "${1:-}" in
  (--claude)
    context:claude
    ;;
  (*)
    context:render "$@"
esac

# ----------------------------------------------------------------------------------------------------------------------
