#!/usr/bin/env bash
# kit-update - moves the repository and the home directory to the release that runs it (kit verb: installation)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit update
#
# kit update takes no arguments. It moves the repository and the home directory from the release kit.yml declares,
# the previous release, to the release that runs it, and writes that release's version into kit.yml. bin/kit, the
# loader, runs the release kit.yml declares, so the release to move to is named with the kit option: kit
# --version=0.2.0 update. A plain kit update runs the declared release, and brings every delivered file back to it.
# The active packages are resolved again from the release that runs: a package an active one now depends on or
# includes comes in, and so does a new default package. A package kit.yml declares as excluded stays out, unless a
# package depends on it. For each delivered file:
#
#   - a file new in this release is written when nothing, or the same content, is there, and refused otherwise
#   - a merged JSON file is merged by key
#   - a region is regenerated
#   - a missing file is written
#   - a path under .kit/ is brought to its state: a link to its source, or a readonly copy; one that holds a file
#     kit never placed is the repository's own, and is refused
#   - any other file unchanged since the previous release is replaced
#   - any other file edited since the previous release gets a three-way merge, which leaves conflict markers on a
#     conflict
#   - where the previous release's file is the same as this release's, as at the same version, there is nothing to
#     merge: a file that is not as kit placed it is named, and stays as it is
#
# A file that stays may hold an edit, an answer since changed in kit.yml, or a file kit never placed, as in a fresh
# clone, which has no manifest; kit cannot tell them apart. To take the release's file, with the answers kit.yml
# holds now, move the file aside or remove it, then run kit update again. kit check names the same remedy.
#
# A merge by key, or a three-way merge, needs the previous release as its base. The base is the first of:
#
#   1. the directory KIT_BASE names
#   2. this release, when the previous release is the same version
#   3. the previous release, from the kit's cache, or downloaded from its public tarball; never for an unreleased
#      previous version
#
# kit update checks, before it writes anything, that every merge has its base and that every region it regenerates
# is marked rightly: one directive with one end line after it, or neither. When a base is missing, or a region's
# markers are out of order, doubled, or never closed, it names each path, writes nothing, and the declared version
# stays the previous one, so the next run starts from the same place.
#
# Arguments:
#
# Exits 0 when the update is complete, and 1 when a base is missing, a region is marked wrongly, a file needs to be
# resolved by hand, the packages' depends and includes lines form a cycle, or a list it reads, such as the packages
# kit.yml declares, cannot be read, and 2 on a usage error. At a cycle, nothing is written.
#
# see: modules/bash/place.sh, modules/bash/manifest.sh, modules/bash/release.sh

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release settings resolve render place materialize manifest file

guard:arguments update "$@" || exit $?

guard:require tool:jq
settings:require
# The sources' roots are read here, in this shell, so the subshells below inherit them: read in one, they are read
# again in the next.
resolve:roots || exit 1
declare -a recorded excluded defaults packages delivered
list:read recorded settings:packages || exit 1
list:read excluded settings:excludes || exit 1
list:read defaults resolve:defaults "${kit_root}" || exit 1
# A default removed by kit packages remove is excluded, and stays out.
for package in "${excluded[@]}"
do
  readarray -t defaults < <(list:without "${package}" "${defaults[@]}")
done
resolve:require "${kit_root}" "${recorded[@]}"
# The active set is resolved again from this release; the header says what comes in and what stays out.
list:read packages resolve:active "${kit_root}" "${excluded[*]}" "${defaults[@]}" "${recorded[@]}" || exit 1
for package in "${excluded[@]}"
do
  if list:among "${package}" "${packages[@]}"
  then
    needed=$(resolve:dependents "${kit_root}" "${package}" "${packages[@]}" | paste -s -d ' ' -)
    warn "${package} was excluded, but ${needed} depends on it, so it is back"
  fi
done
list:read excluded resolve:exclusions "${excluded[*]}" "${packages[@]}" || exit 1
previous=$(settings:version)
current=$(release:version)
render:all "${kit_root}" "${packages[@]}"
section "kit update ${previous} → ${current}, packages: ${packages[*]}"

base_root=""
if [[ -n "${KIT_BASE:-}" ]]
then
  base_root=${KIT_BASE}
elif [[ "${previous}" == "${current}" ]]
then
  base_root=${kit_root}
elif [[ "${previous}" != "$(release:unreleased)" ]]
then
  # A base that cannot be fetched has said so. The update goes on without it, and refuses each edited file that
  # needs it.
  base_root=$(release:fetch "${previous}" || true)
fi
# The base is read, not validated: the current release was validated above, and a package the base predates renders
# nothing from it.
if [[ -n "${base_root}" ]] && ! render:packages "${base_root}" "${packages[@]}"
then
  error "the base release at ${base_root} could not be read; see above"
  exit 1
fi

# read-base <base> reads, in this shell, what the loops below ask about each path the base delivers, so they start no
# process for one path. It fills:
#
#   delivered     the rows "<path>\t<source>" this release delivers under the base (place:delivered)
#   root_of       the base's root, which a path is joined to, as release:dest joins them: empty for repo
#   base_key      the key place_source keeps the base release's sources under, or empty without a base release
#   kind_of       each path's kind, as place:kind names it
#   digest_of     the digest the manifest records for each path. When it records none, as in a fresh clone or
#                 bin/refresh's export, where the manifest is not committed, the base release's digest of the path,
#                 when that release delivers it. A path with neither is new in this release.
#   from_base     each path whose digest is the base release's, the manifest recording none
#   installed_of  the digest of the file at each copied path outside .kit/ that has one. A path the batch could not
#                 digest, as when a file cannot be read, is left out, and digested on its own where it is asked about.
#
# Every digest is taken by one process for the base, before anything is written. It fails when a list it reads cannot
# be read.
read-base() {
  local base=$1 row path src dest kind i
  local -a unrecorded=() sources=() copies=() dests=() digests=()
  list:read delivered place:delivered "${kit_root}" "${base}" "${packages[@]}" || return 1
  release:dest "${base}" '' root_of
  base_key=''
  if [[ -n "${base_root}" ]]
  then
    place:delivered "${base_root}" "${base}" "${packages[@]}" >/dev/null || return 1
    place:key base_key "${base_root}" "${base}" "${packages[@]}"
  fi
  manifest:records digest_of "${base}" || return 1
  kind_of=() installed_of=() from_base=()
  for row in "${delivered[@]}"
  do
    IFS=$'\t' read -r path src <<<"${row}"
    [[ -n "${path}" ]] || continue
    dest=${root_of}${path}
    place:kind "${src}" "${dest}" kind
    kind_of[${path}]=${kind}
    if [[ -z "${digest_of[${path}]+x}" && -n "${base_key}" && -n "${place_source[${base_key}${path}]+x}" ]]
    then
      unrecorded+=("${path}")
      sources+=("${place_source[${base_key}${path}]}")
    fi
    if [[ "${kind}" == copy && -f "${dest}" ]] && ! materialize:owned "${base}" "${path}"
    then
      copies+=("${path}")
      dests+=("${dest}")
    fi
  done
  if (( ${#unrecorded[@]} > 0 )) && ! file:digests digests "${sources[@]}" 2>/dev/null
  then
    # One the batch could not read is digested on its own, and one that cannot be read at all records nothing.
    digests=()
    for src in "${sources[@]}"
    do
      digests+=("$(file:digest < "${src}")")
    done
  fi
  for i in "${!unrecorded[@]}"
  do
    digest_of[${unrecorded[i]}]=${digests[i]}
    from_base[${unrecorded[i]}]=1
  done
  if (( ${#copies[@]} > 0 )) && file:digests digests "${dests[@]}" 2>/dev/null
  then
    for i in "${!copies[@]}"
    do
      installed_of[${copies[i]}]=${digests[i]}
    done
  fi
}

# installed-digest <src> <dest> <path> prints the digest of the repository's copy of the release's content at <dest>,
# from installed_of, or, for a path read-base left out, read now.
installed-digest() {
  if [[ -n "${installed_of[$3]:-}" ]]
  then printf '%s\n' "${installed_of[$3]}"
  else place:installed "$1" "$2" | file:digest
  fi
}

# judge-owned <base> puts in owned_state each materialized path's state, and in owned_ok whether it is in that state,
# for every one the base delivers, all judged at once before any is changed, as materialize:all judges them.
# shellcheck disable=SC2034  # owned_source is read by materialize:judge, through a reference
judge-owned() {
  local row path src state
  local -a owned=()
  local -A owned_source=()
  owned_state=() owned_ok=()
  for row in "${delivered[@]}"
  do
    IFS=$'\t' read -r path src <<<"${row}"
    [[ -n "${path}" && "${kind_of[${path}]:-}" == copy ]] || continue
    materialize:owned "$1" "${path}" || continue
    owned+=("${path}")
    owned_source[${path}]=${src}
    materialize:state state "${src}" "${root_of}${path}"
    owned_state[${path}]=${state}
  done
  (( ${#owned[@]} == 0 )) || materialize:judge owned_ok owned_state owned_source "${owned[@]}"
}

# lacks-base <base> <path> <src> is true when updating the path needs the base release, and the base release is
# missing. It reads what read-base filled for the base.
lacks-base() {
  local base=$1 path=$2 src=$3 dest=${root_of}$2 kind=${kind_of[$2]}
  [[ -n "${digest_of[${path}]:-}" ]] || return 1
  # A materialized path is brought to its state from this release alone.
  if materialize:owned "${base}" "${path}" && [[ "${kind}" == copy ]]
  then
    return 1
  fi
  [[ -z "${base_root}" || -z "${place_source[${base_key}${path}]:-}" ]] || return 1
  [[ "${kind}" == merge ]] && return 0
  [[ "${kind}" != region ]] && place:installed "${src}" "${dest}" >/dev/null 2>&1 \
    && [[ "${digest_of[${path}]}" != "$(installed-digest "${src}" "${dest}" "${path}")" ]]
}

declare -A digest_of=() kind_of=() installed_of=() from_base=() owned_state=() owned_ok=()
root_of='' base_key='' did=''
# Find every path that lacks its base, and every region a write would refuse, before writing anything, so an update
# is all or nothing.
skipped=0
refused=0
for base in $(release:bases)
do
  read-base "${base}" || exit 1
  for row in "${delivered[@]}"
  do
    IFS=$'\t' read -r path src <<<"${row}"
    [[ -n "${path}" ]] || continue
    if lacks-base "${base}" "${path}" "${src}"
    then
      error "${root_of}${path} cannot be updated without the base release ${previous};" \
        "set KIT_BASE to a copy of it"
      skipped=$(( skipped + 1 ))
    fi
  done
  printf -v wanted '%s\n' "${delivered[@]%%$'\t'*}"
  count=$(place:refusals "${base}" "${packages[@]}" <<<"${wanted}")
  refused=$(( refused + count ))
done
if (( skipped > 0 ))
then
  error "${skipped} path(s) stay at ${previous}, and so does the manifest; set KIT_BASE, then run:" \
    "$(release:update-command "${previous}")"
  exit 1
fi
if (( refused > 0 ))
then
  error "${refused} region(s) cannot be written, each named above; nothing is written, and the manifest stays at" \
    "${previous}; mend the markers, then run: $(release:update-command "${previous}")"
  exit 1
fi

conflicts=0
for base in $(release:bases)
do
  read-base "${base}" || exit 1
  judge-owned "${base}"
  for row in "${delivered[@]}"
  do
    IFS=$'\t' read -r path src <<<"${row}"
    [[ -n "${path}" ]] || continue
    dest=${root_of}${path}
    known=${digest_of[${path}]:-}
    if [[ -z "${known}" ]]
    then
      place:new "${src}" "${dest}" "new in ${current}" || conflicts=$(( conflicts + 1 ))
      continue
    fi
    previous_src=""
    [[ -z "${base_root}" ]] || previous_src=${place_source[${base_key}${path}]:-}
    kind=${kind_of[${path}]}
    if [[ -n "${owned_state[${path}]+x}" ]]
    then
      # A materialized path is a link to its source or a copy of the release's file, brought to that state, never
      # merged: an edit under .kit/ is nobody's to keep. One the manifest never recorded is kit's when it holds what
      # this release places, or what the base release placed. Anything else there is the repository's own file: it
      # is named and stays, as materialize:all leaves it.
      if [[ -n "${from_base[${path}]+x}" && "${owned_ok[${path}]:-}" != true ]] \
        && [[ -e "${dest}" || -L "${dest}" ]] && [[ ! -f "${dest}" || "${known}" != "$(file:digest "${dest}")" ]]
      then
        error "${dest}: a different file is there already; move it aside, or remove it if it is not yours"
        conflicts=$(( conflicts + 1 ))
        continue
      fi
      materialize:bring did "${src}" "${dest}" "${owned_state[${path}]}" "${owned_ok[${path}]:-}" || exit 1
      case "${did}" in
        (kept) step "${dest}: as ${current} has it" ;;
        (placed) step "${dest}: placed from ${current}" ;;
        (replaced) step "${dest}: replaced from ${current}"
      esac
      continue
    fi
    if [[ "${kind}" == merge ]]
    then
      step "${dest}: merged by key"
      place:content "${src}" "${dest}" "${previous_src}"
    elif [[ "${kind}" == region ]]
    then
      # A region's content comes from its command, so it is regenerated, never merged.
      place:content "${src}" "${dest}"
      step "${dest}: the region regenerated"
    elif ! place:installed "${src}" "${dest}" >/dev/null 2>&1
    then
      step "${dest}: missing, written"
      place:content "${src}" "${dest}"
    elif [[ "${known}" == "$(installed-digest "${src}" "${dest}" "${path}")" ]]
    then
      step "${dest}: unchanged since ${previous}, replaced"
      place:content "${src}" "${dest}"
    elif cmp --silent "${previous_src}" "${src}"
    then
      # The base release's file is this release's, as at the same version: a merge would bring nothing. What is there
      # may be an edit, a render from an answer since changed, or a file kit never placed, and nothing tells them
      # apart, so it stays, and the person is told what brings the release's file. kit check names the same remedy.
      warn "${dest}: not as kit placed it, and ${current} has nothing to merge into it, so it stays as it is; to" \
        "take the release's file, as after an answer changed in kit.yml, move it aside or remove it, then run:" \
        "kit update"
    else
      step "${dest}: edited since ${previous}, three-way merged"
      if ! git merge-file --marker-size 7 "${dest}" "${previous_src}" "${src}"
      then
        warn "${dest}: conflict markers are left in the file; resolve them, then run: kit check"
        conflicts=$(( conflicts + 1 ))
      fi
    fi
  done
  place:retire "${base_root}" "${base}" "${previous}" "${current}" "${packages[@]}"
done

# Before the manifest is rewritten, so a path under .kit/ the loop refused to overwrite is still unrecorded, and stays
# as it is. The manifest then records every path but that one: the loop placed each.
materialize:all "${packages[@]}"
manifest:write-all "${excluded[*]}" "${packages[@]}"
if (( conflicts > 0 ))
then
  error "${conflicts} file(s) need a hand; see above."
  exit 1
fi
release:finish "${packages[@]}"

# ----------------------------------------------------------------------------------------------------------------------
