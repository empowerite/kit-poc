#!/usr/bin/env bash
# kit-hydrate - places what the active packages deliver under .kit/ (kit verb: installation)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit hydrate [--quick]
#
# Reads the packages kit.yml declares, and brings every path they deliver under .kit/ to its state:
#
#   - a link to its source, when the source is inside the worktree
#   - otherwise a copy without the write bit
#
# It also writes .kit/.gitignore, which names those paths and itself, and .kit/manifest, with a record for each path
# it placed. A path outside .kit/, which it never places, keeps the record it had, and so does one there that this
# release no longer delivers, which kit update retires. It chooses nothing; kit install chooses. It prints one line
# per path it placed or replaced. It warns about a delivered path git still tracks, and about a file under a delivered
# directory that no active package delivers.
#
# A delivered path that holds a different file, which kit never recorded, is the repository's own. It is named, left
# as it is, and gets no record, so no later command replaces it. kit hydrate fails until it is moved aside or removed.
#
# Every verb that reads a delivered file hydrates first. This verb is for a fresh clone or worktree, before any other
# command.
#
# --quick is for a shell hook, as in mise's [hooks] enter = "kit hydrate --quick". It then starts nothing and says
# nothing when everything is in place, or outside a repository that declares a kit version. Otherwise it does the
# whole job.
#
# Arguments:
#   --quick   for a shell hook: silent when everything is in place
#
# Exits 0 on success, 1 when kit.yml cannot be read, with --quick too, 1 when a delivered path under .kit/ holds a
# file kit did not place, and 1 in a repository that declares no kit version, unless --quick, and 2 on a usage error.
#
# see: modules/bash/materialize.sh, docs/toolchains.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use release settings materialize
guard:arguments hydrate "$@" || exit $?

if [[ "${1:-}" == --quick ]]
then
  version=$(settings:version) || exit 1
  [[ -n "${version}" ]] || exit 0
  materialize:hydrated && exit 0
else
  settings:require
fi
materialize:hydrate --full
# shellcheck disable=SC2154  # materialize_left is set by modules/bash/materialize.sh
if (( ${#materialize_left[@]} > 0 ))
then
  error "${#materialize_left[@]} path(s) under .kit/ hold a file kit did not place, each named above; move each" \
    "aside, or remove it, then run: kit hydrate"
  exit 1
fi
ok "kit $(release:version) hydrated .kit/, packages: $(settings:packages | paste -s -d ' ' -)"

# ----------------------------------------------------------------------------------------------------------------------
