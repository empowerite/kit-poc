#!/usr/bin/env bash
# kit-model - checks the model of kit's entities (kit verb: files)
# ----------------------------------------------------------------------------------------------------------------------
# Usage:
#   kit model [--release=<dir>] (check | table (--entity=<name> | --domain=<name>) | svg (--domain=<name> | --overview))
#
# The model is the entities kit works with, one YAML file each: the release's under modules/model/, and the
# repository's under .kit/model/, as docs/model.md says. kit model check reads both and checks them: every relation has
# its other side, every type is known, and an extension only narrows what it extends.
#
# It prints each finding on a line of its own, then, last, how many entities and how many stubs the model holds, as
# model: 12 entities, 2 stubs. A file that cannot be read ends it with what the reader printed.
#
# table prints a markdown table of the model, for a page that holds it in a kit:generate region. --entity= gives the
# entity's fields, Field | Type | Arity | Source | Status | Read by | Means, one row each; a sum gives its variants and
# their fields, and a stub one line that says it is one. --domain= gives the relations of every entity of the domain,
# Relation | To | Arity | Ordered | Inverse | Means. Arity is 1, 0..1, 0..*, or 1..*. A name the model does not hold
# exits 2 and names the ones it does.
#
# svg prints a diagram of the model as SVG, the same bytes for the same model under any locale. --domain= draws a card
# for each entity of the domain, and a line for each pair of inverse relations, with the name and arity of each
# relation at the end it goes to; a derived relation is dashed, and a relation to another domain's entity is a short
# arrow with that entity's name. --overview draws a panel for each domain, with its entities.
#
# Arguments:
#   --release=<dir>    a model directory that exists, read in place of the release's modules/model; given once
#   check              checks the model
#   table              prints a table of one entity or one domain
#   svg                prints a diagram of one domain, or of every domain
#   --entity=<name>    the entity whose fields the table lists
#   --domain=<name>    the domain whose relations the table lists, or whose entities the diagram draws
#   --overview         draws a panel for each domain of the model
#
# Exits 0 when the model holds, or a table or a diagram is printed; 1 when the model has a finding, a file cannot be
# read, or jq fails; and 2 on a usage error: an empty --release=, one given twice, or one that is not a directory; table
# with neither --entity= nor --domain=, or both; svg with neither --domain= nor --overview, or both; and a name of an
# entity or a domain the model does not hold.
#
# see: modules/bash/model.sh, modules/jq/model.jq, modules/jq/modelsvg.jq, docs/model.md

set -o errexit -o nounset -o pipefail
# shellcheck source=modules/bash/1st.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../modules/bash/1st.sh"
kit:enter
use model file
guard:arguments model "$@" || exit $?

# model-jq <program> [<jq argument>…] runs a jq program over the built model, with the model modules imported. It
# prints the program's output, and keeps what jq writes to stderr out of it. When jq fails, it prints that output,
# then jq's message, and returns 1, because jq's own status, 3 or 5, is none of the verb's.
model-jq() {
  local program=$1 out
  shift
  # shellcheck disable=SC2154  # jq_errors is set by file:temp
  if ! out=$(jq -L "${kit_root}/modules/jq" --raw-output "$@" \
    'import "model" as model; import "modelsvg" as modelsvg; model::build | '"${program}" \
    <<<"${loaded}" 2>"${jq_errors}")
  then
    [[ -z "${out}" ]] || printf '%s\n' "${out}"
    cat "${jq_errors}"
    return 1
  fi
  printf '%s\n' "${out}"
}

# shellcheck disable=SC2154  # syntax_options is set by guard:arguments
release=${syntax_options[--release]:-}
if [[ -n "${release}" && ! -d "${release}" ]]
then
  error "--release=${release} is not a directory; run: kit help model"
  exit 2
fi
loaded=$(model:load ${release:+"${release}"}) || exit 1
file:temp jq_errors jq || exit 1
if [[ "${syntax_literals[0]}" == check ]]
then
  # The findings, one a line, then the count.
  report=$(model-jq 'model::check[], "model: \(.entities | length) entities, \(model::stubs | length) stubs"') || {
    printf '%s\n' "${report}"
    exit 1
  }
  printf '%s\n' "${report}"
  [[ "${report}" != *$'\n'* ]]
  exit
fi
if [[ "${syntax_literals[0]}" == svg && -n "${syntax_options[--overview]+x}" ]]
then
  model-jq 'modelsvg::overview'
  exit
fi
if [[ -n "${syntax_options[--entity]+x}" ]]
then
  kind=entity plural=entities name=${syntax_options[--entity]} known='[.entities | keys[]]'
else
  kind=domain plural=domains name=${syntax_options[--domain]}
  known='([.domains | keys[]] + [.entities[].domain] | unique)'
fi
names=$(model-jq "${known}[]") || {
  printf '%s\n' "${names}"
  exit 1
}
if ! grep --quiet --line-regexp --fixed-strings -- "${name}" <<<"${names}"
then
  known_list=$(paste -s -d, - <<<"${names}" | sed 's/,/, /g')
  error "no ${kind} named ${name}; the ${plural} are: ${known_list}; run: kit help model"
  exit 2
fi
# the function that prints the table or the diagram of the named entity or domain
case "${syntax_literals[0]} ${kind}" in
  ("table entity") call=model::fields ;;
  ("table domain") call=model::relations ;;
  (*) call=modelsvg::domain
esac
model-jq "${call}(\$name)" --arg name "${name}"

# ----------------------------------------------------------------------------------------------------------------------
