{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/empowerite/kit/modules/model/model.schema.json",
  "title": "a model file: one entity of kit's model",
  "description": "What one entity is: its layer, its fields, and its relations to other entities. docs/model.md describes each key.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    { "required": ["entity"] },
    { "required": ["extends"] }
  ],
  "properties": {
    "entity": { "$ref": "#/$defs/name", "description": "The entity this file defines." },
    "extends": { "$ref": "#/$defs/name", "description": "The entity this file adds fields and relations to." },
    "layer": { "enum": ["native", "logical"] },
    "tool": { "type": "string", "minLength": 1, "description": "The tool a native entity lives in, as git." },
    "over": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" },
      "description": "The entities a logical entity stands over."
    },
    "means": { "type": "string", "minLength": 1 },
    "stub": { "type": "boolean" },
    "sum": { "type": "boolean" },
    "variants": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "additionalProperties": { "$ref": "#/$defs/name" }
      },
      "description": "For a sum: each variant and the entity each of its fields holds."
    },
    "fields": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "relations": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/relation" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "native" } }, "required": ["layer"] },
      "then": { "not": { "required": ["over"] } }
    },
    {
      "if": { "properties": { "layer": { "const": "logical" } }, "required": ["layer"] },
      "then": { "not": { "required": ["tool"] } }
    },
    {
      "if": { "properties": { "sum": { "const": true } }, "required": ["sum"] },
      "then": { "required": ["variants"] }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "description": "An entity's name."
    },
    "arity": {
      "enum": ["one", "option", "many", "some"],
      "default": "one"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "anyOf": [
            { "enum": ["Text", "Int", "Bool", "Bytes", "Path", "Url", "Time", "Hash"] },
            { "$ref": "#/$defs/name" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enum"],
              "properties": {
                "enum": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          ]
        },
        "arity": { "$ref": "#/$defs/arity" },
        "source": { "enum": ["stored", "derived"] },
        "status": { "enum": ["held", "planned", "unused"] },
        "from": { "type": "string", "minLength": 1, "description": "Where a derived field comes from." },
        "read-by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*( (--)?[a-z][a-z0-9-]*)* (\\*|[A-Za-z_][A-Za-z0-9_-]*)(\\.(\\*|[A-Za-z_][A-Za-z0-9_-]*))*$",
          "description": "\"<verb> <jsonkey>\": the verb that prints the field, in one or more words, any word after the first a lowercase word or an option such as --show written without its value, then the key it prints, the last word, dotted where it is nested, with * for any key of a mapping or any element of an array."
        },
        "means": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "held" } }, "required": ["status"] },
          "then": { "required": ["read-by"] }
        },
        {
          "if": { "properties": { "source": { "const": "derived" } }, "required": ["source"] },
          "then": { "required": ["from"] }
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "$ref": "#/$defs/name" },
        "arity": { "$ref": "#/$defs/arity" },
        "ordered": { "type": "boolean" },
        "inverse": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*\\.[a-z][a-z0-9-]*$",
          "description": "The relation that runs the other way, as Entity.relation."
        },
        "derived": { "type": "string", "minLength": 1, "description": "A sentence that says how the relation is derived; it replaces inverse." },
        "means": { "type": "string", "minLength": 1 }
      },
      "not": { "required": ["inverse", "derived"] }
    }
  }
}
