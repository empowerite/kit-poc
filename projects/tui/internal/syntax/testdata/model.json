{
  "verb": "model",
  "purpose": "checks the model of kit's entities",
  "usage": [
    "kit model [--release=<dir>] (check | table (--entity=<name> | --domain=<name>) | page --domain=<name> | svg (--domain=<name> | --overview))"
  ],
  "syntax": [
    [
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "option",
              "name": "release",
              "value": "dir",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": false,
        "alternatives": [
          [
            {
              "kind": "literal",
              "name": "check",
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "table",
              "repeat": false
            },
            {
              "kind": "group",
              "optional": false,
              "alternatives": [
                [
                  {
                    "kind": "option",
                    "name": "entity",
                    "value": "name",
                    "repeat": false
                  }
                ],
                [
                  {
                    "kind": "option",
                    "name": "domain",
                    "value": "name",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "page",
              "repeat": false
            },
            {
              "kind": "option",
              "name": "domain",
              "value": "name",
              "repeat": false
            }
          ],
          [
            {
              "kind": "literal",
              "name": "svg",
              "repeat": false
            },
            {
              "kind": "group",
              "optional": false,
              "alternatives": [
                [
                  {
                    "kind": "option",
                    "name": "domain",
                    "value": "name",
                    "repeat": false
                  }
                ],
                [
                  {
                    "kind": "flag",
                    "name": "overview",
                    "repeat": false
                  }
                ]
              ],
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ]
  ],
  "arguments": {
    "--release": {
      "description": "a model directory that exists, read in place of the release's modules/model; given once"
    },
    "check": {
      "description": "checks the model"
    },
    "table": {
      "description": "prints a table of one entity or one domain"
    },
    "page": {
      "description": "prints the body of the page of one domain"
    },
    "svg": {
      "description": "prints a diagram of one domain, or of every domain"
    },
    "--entity": {
      "description": "the entity whose fields the table lists"
    },
    "--domain": {
      "description": "the domain whose relations the table lists, whose page is printed, or whose entities the diagram draws"
    },
    "--overview": {
      "description": "draws a panel for each domain of the model"
    }
  }
}
