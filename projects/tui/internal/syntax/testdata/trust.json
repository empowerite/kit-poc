  "arguments": {
    "--text": {
      "description": "prints the stages as text, even on a terminal"
    },
    "--json": {
      "description": "the stages as one JSON object: contract, stages, then each stage's document under its name, null for one that could not be read"
    },
    "--jq": {
      "description": "the same JSON, formatted by jq for a person"
    },
    "--stages": {
      "description": "prints the stages, one per line, in order, the same over any workspace"
    },
    "--marks": {
      "description": "prints a mark per stage, as one JSON object, which changes when what the stage draws does; null for controls and waivers, which are read again only on Refresh"
    },
    "evidence": {
      "description": "the attestations of the 5 newest releases' assets and the 20 newest artifacts"
    },
    "findings": {
      "description": "the code scanning, Dependabot, and secret scanning alerts, open and dismissed"
    },
    "controls": {
      "description": "the rulesets and the protection that guard the default branch"
    },
    "waivers": {
      "description": "who may bypass each control, and each alert dismissed"
    },
    "policy": {
      "description": "each rule kit policy judges by, as kit policy --rules lists them"
    },
    "enforcement": {
      "description": "what binds an agent and what is advice, per harness and for the repository, in four tiers"
    },
    "--clone": {
      "description": "trusts a clone, with the arguments below; on its own it asks you, and records your answer"
    },
    "--yes": {
      "description": "with --clone, records the trust without asking, as a CI job does for its own checkout"
    },
    "--list": {
      "description": "with --clone, prints the clones and the folders you trust, one per line"
    },
    "--check": {
      "description": "with --clone, prints the name the clone is trusted by, and exits 0 when it is trusted, as it asks now, and 1 when not; it asks nothing and runs nothing of the clone's, for a screen that asks for the trust itself"
    },
    "--asks": {
      "description": "with --clone, prints what the clone asks kit to run, one line each, as kit trust --clone shows it, and asks nothing"
    },
    "--revoke": {
      "description": "with --clone, takes the trust of a clone or a folder back"
    },
    "<path>": {
      "description": "with --clone, a clone, or a directory in one, the clone here when none is given; a folder outside a clone that holds a kit.yml; or a folder ending in /"
    }
  }
}
