{
  "verb": "work",
  "purpose": "starts or resumes work on issues",
  "usage": [
    "kit work <reference>… [--sweep | --no-sweep]",
    "kit work --title=<text> [<reference>…] [--sweep | --no-sweep]",
    "kit work --pr=<number> <reference>…"
  ],
  "syntax": [
    [
      {
        "kind": "operand",
        "name": "reference",
        "repeat": true
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "sweep",
              "repeat": false
            }
          ],
          [
            {
              "kind": "flag",
              "name": "no-sweep",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ],
    [
      {
        "kind": "option",
        "name": "title",
        "value": "text",
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "operand",
              "name": "reference",
              "repeat": true
            }
          ]
        ],
        "repeat": false
      },
      {
        "kind": "group",
        "optional": true,
        "alternatives": [
          [
            {
              "kind": "flag",
              "name": "sweep",
              "repeat": false
            }
          ],
          [
            {
              "kind": "flag",
              "name": "no-sweep",
              "repeat": false
            }
          ]
        ],
        "repeat": false
      }
    ],
    [
      {
        "kind": "option",
        "name": "pr",
        "value": "number",
        "repeat": false
      },
      {
        "kind": "operand",
        "name": "reference",
        "repeat": true
      }
    ]
  ],
  "arguments": {
    "<reference>": {
      "description": "the issues, each named with its tracker: 7, #7, or AB#4521; the first is the primary, and the one pull request closes them all"
    },
    "--sweep": {
      "description": "moves the desk's uncommitted work into the new worktree, as kit work does at a terminal"
    },
    "--no-sweep": {
      "description": "leaves the desk's uncommitted work on the desk"
    },
    "--title": {
      "description": "creates an issue with that title and starts it; with references, creates it as their parent, as kit gather does, and starts it with them"
    },
    "--pr": {
      "description": "adds the issues to one of the caller's own open pull requests instead: each is assigned to the caller and closed by it"
    }
  }
}
