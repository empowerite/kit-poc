#!/usr/bin/env bash
# ci - this repository's gate: kit lint, the schemas, the links, bats, kit check
# ----------------------------------------------------------------------------------------------------------------------
# The gate setting in kit.yml names this script, so kit gate runs it, with the toolchain's tools on PATH,
# and kit ci runs it in CI. It runs, in order:
#
#   - kit lint over every tracked path
#   - kit syntax --check: every verb's usage line parses, and every argument has its description
#   - kit model check: the model's entity files hold together: every relation has its other side, every type is known
#   - kit model svg: each checked-in diagram of a modelled domain is what the model draws, and every warning it prints
#     is one the list below expects
#   - ajv: every package.yml, kit.yml, every model file, every kind, and the frontmatter of every rule and style
#     against their schemas, and the examples in every schema of a tool's output under docs/integrations/ against it
#   - lychee: every link in the markdown, offline, including fragments
#   - ajv: the front matter of every page of the tutorials site against its schema
#   - npm run check over projects/tutorials/, the tutorials site: tsc, its tests, and a build for a base
#     that fails on an empty page, a dead link, or a bad base
#   - the bats suite, one job per CPU, each test stopped and failed at five minutes, with KIT_SNAPSHOTS empty, so a
#     snapshot of the kit's surface is compared, never written; bin/contracts writes them. A test that needs a tool
#     kit.yml pins fails where the tool is missing, and every test that skipped is listed
#   - gofmt, go vet, and go test over projects/tui/, the kit tui binary, with every one of its statements covered
#   - kit/bin/kit check over this repository's installed copy of its own kit
#
# The pre-commit hook is a faster check over the staged paths only.
#
#   kit gate

set -o errexit -o nounset -o pipefail

cd "$(git rev-parse --show-toplevel)"
kit/bin/kit lint --all-files
kit/bin/kit syntax --check
kit/bin/kit model check
frontmatter=$(mktemp -d)
trap 'rm -rf "${frontmatter}"' EXIT
# The diagrams of the modelled domains are what the model draws: each docs/entities/<domain>.svg whose domain has a
# directory under kit/modules/model/ and a generated page, docs/entities/<domain>.md, beside it. A hand-made diagram,
# such as platform.svg, has no page. The pages are held by kit check, which runs kit generate --check, at the end. A
# label kit model svg cannot keep clear is a warning, and each warning must be one this list expects, by domain and
# entity, with the reason no layout hint removes it. A listed warning that no longer comes is stale, and fails too.
# Each reason is why no hint clears the entity: an edge whose ends lie closer than their labels are wide.
declare -A expected_warnings=(
  [git GitTag]="it holds a relation back for each sum that reaches it, and their ends crowd its edges"
  [git-repository GitWorktreeDir]="the lines of GitDir, GitRef, and GitReflogEntry crowd its bottom edge"
  [code Branch]="it meets six cards, and the ends of Remote, Checkout, and Change crowd its top edge"
  [code Worktree]="Checkout reaches it three times, and Head, Branch, Commit, and UnbornBranch crowd its bottom edge"
)
declare -A warned=()
mkdir "${frontmatter}/svg"
for svg in docs/entities/*.svg
do
  domain=$(basename "${svg}" .svg)
  [[ -d "kit/modules/model/${domain}" && -f "docs/entities/${domain}.md" ]] || continue
  if ! kit/bin/kit model svg --domain="${domain}" > "${frontmatter}/svg/${domain}.svg" \
    2> "${frontmatter}/svg/${domain}.err"
  then
    echo "❌ kit model svg --domain=${domain} failed:" >&2
    cat "${frontmatter}/svg/${domain}.err" >&2
    exit 1
  fi
  cmp -s "${frontmatter}/svg/${domain}.svg" "${svg}" || {
    # The command docs/model.md gives, through a scratch file, so a failed run leaves the diagram as it was.
    # shellcheck disable=SC2016  # the ${TMPDIR:-/tmp} is for the reader's shell to expand
    echo "❌ ${svg} is stale: write it afresh with" \
      'kit/bin/kit model svg --domain='"${domain}"' > "${TMPDIR:-/tmp}/'"${domain}"'.svg" &&' \
      'mv "${TMPDIR:-/tmp}/'"${domain}"'.svg" '"${svg}" >&2
    exit 1
  }
  while IFS= read -r line
  do
    [[ "${line}" =~ the\ labels\ of\ ([A-Za-z0-9]+)\ could\ not ]] || continue
    warned["${domain} ${BASH_REMATCH[1]}"]=1
    [[ -n "${expected_warnings["${domain} ${BASH_REMATCH[1]}"]:-}" ]] || {
      echo "❌ kit model svg --domain=${domain} warns of ${BASH_REMATCH[1]}, which bin/ci does not expect:" >&2
      echo "${line}" >&2
      exit 1
    }
  done < "${frontmatter}/svg/${domain}.err"
done
for key in "${!expected_warnings[@]}"
do
  [[ -n "${warned["${key}"]:-}" ]] || {
    echo "❌ bin/ci expects a warning of ${key#* } in the diagram of ${key%% *}, which no longer comes;" \
      "take it off the list" >&2
    exit 1
  }
done
ajv validate --spec=draft2020 -s kit/packages/package.schema.json \
  -d 'kit/packages/*/package.yml' -d 'kit/packages/*/*/package.yml'
ajv validate --spec=draft2020 -s .kit/kit.schema.json -d kit.yml
# The model: each entity file against the entity schema, and each domain.yml, which is no entity, against its own.
shopt -s nullglob
entities=()
for file in kit/modules/model/*/*.yml
do
  [[ "${file##*/}" == domain.yml ]] || entities+=(-d "${file}")
done
(( ${#entities[@]} == 0 )) || ajv validate --spec=draft2020 -s kit/modules/model/model.schema.json "${entities[@]}"
domains=(kit/modules/model/*/domain.yml)
shopt -u nullglob
(( ${#domains[@]} == 0 )) || ajv validate --spec=draft2020 -s kit/modules/model/domain.schema.json -d "kit/modules/model/*/domain.yml"
# A rule's frontmatter is YAML between the two --- lines; ajv reads it from a copy of just those lines.
for file in kit/packages/*/files/repo/.kit/rules/*.md kit/packages/*/*/files/repo/.kit/styles/*.md
do
  awk 'NR == 1 && $0 == "---" { on = 1; next } on && $0 == "---" { exit } on' "${file}" > "${frontmatter}/${file//\//-}.yml"
done
ajv validate --spec=draft2020 -s kit/packages/rule.schema.json -d "${frontmatter}/*.yml"
# A kinds file is a stream of one document per kind; ajv reads each document from a file of its own.
mkdir "${frontmatter}/kinds"
for file in kit/packages/*/files/repo/.kit/kinds/*.yml
do
  awk -v out="${frontmatter}/kinds/${file//\//-}" '
    BEGIN { n = 0 }
    /^---[ \t]*$/ { if (lines) n++; lines = 0; next }
    /^[ \t]*(#|$)/ { next }
    { print > (out "." n ".yml"); lines++ }' "${file}"
done
ajv validate --spec=draft2020 -s kit/packages/kind.schema.json -d "${frontmatter}/kinds/*.yml"
# A schema of what a tool prints, beside the tool's page in docs/integrations/, stands alone and carries examples of
# that output; ajv reads each example from a file of its own, and a schema with none fails, as ajv finds no file to
# check. A format, such as date-time, annotates a field and is not checked.
mkdir "${frontmatter}/examples"
for schema in docs/integrations/*/*.schema.json
do
  name=${schema#docs/integrations/}
  name=${name%.schema.json}
  jq --compact-output '.examples[]?' "${schema}" \
    | awk -v out="${frontmatter}/examples/${name//\//-}" '{ print > (out "." NR ".json") }'
  ajv validate --spec=draft2020 --validate-formats=false -s "${schema}" -d "${frontmatter}/examples/${name//\//-}.*.json"
done
# The pages under kit/packages sit below hidden directories, which lychee skips, and the links of a delivered page are
# written from where kit places it. So the placed pages are read where they lie, each by its path under .kit/.
lychee --offline --include-fragments --no-progress README.md CONTRIBUTING.md AGENTS.md docs kit/packages \
  .kit/*.md .kit/welcome/*.md .kit/rules/*.md .kit/styles/*.md
# A tutorial's front matter is YAML between the two --- lines too, read the same way, from a directory of its own.
mkdir "${frontmatter}/tutorials"
while IFS= read -r file
do
  awk 'NR == 1 && $0 == "---" { on = 1; next } on && $0 == "---" { exit } on' "${file}" \
    > "${frontmatter}/tutorials/${file//\//-}.yml"
done < <(find projects/tutorials/src -name '*.mdx')
ajv validate --spec=draft2020 -s projects/tutorials/frontmatter.schema.json -d "${frontmatter}/tutorials/*.yml"
(cd projects/tutorials && npm ci --no-audit --no-fund && npm run check)
# The slowest test takes about a minute on a runner and over two at a desk; one that waits on a terminal forever
# fails at five minutes, naming itself. The tests run side by side, one job per CPU, on GNU parallel from kit.yml:
# nearly all their time goes to starting short processes, so more jobs than CPUs only queue.
# A test of a tool kit.yml pins fails where the tool is missing, as the toolchain is then broken; any other skips. What
# skipped is printed after, so a CI log says which tests did not run.
tap=${frontmatter}/bats.tap
KIT_TESTS_REQUIRE=$(yq '.tools | keys | .[]' kit.yml | tr '\n' ' ') KIT_SNAPSHOTS='' BATS_TEST_TIMEOUT=300 \
  bats --jobs "$(getconf _NPROCESSORS_ONLN)" --timing --print-output-on-failure tests/ | tee "${tap}"
echo "skipped: $(grep -c ' # skip' "${tap}" || true) tests" >&2
grep ' # skip' "${tap}" >&2 || true
(cd projects/tui && test -z "$(gofmt -l .)" && go vet ./... && go test -coverprofile="${frontmatter}/tui.cover" ./...)
# The TUI's tests reach every one of its statements: a statement no test reaches fails the gate, naming each function
# that holds one. The total is no measure of it, as one statement in thousands still rounds to 100.0%.
short=$(cd projects/tui && go tool cover -func="${frontmatter}/tui.cover" | awk '$NF != "100.0%"')
if [[ -n "${short}" ]]
then
  echo "❌ the TUI's tests leave statements no test reaches, in these functions:" >&2
  echo "${short}" >&2
  exit 1
fi
kit/bin/kit check
echo "✅ ci passed"

# ----------------------------------------------------------------------------------------------------------------------
