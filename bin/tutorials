#!/usr/bin/env bash
# tutorials - writes the catalogue of the tutorials, and publishes the copies of their site to the gh-pages branch
# ----------------------------------------------------------------------------------------------------------------------
# bin/tutorials catalogue | site <ref> | publish <directory> <dist> | answers <url> | retire [--dry-run]
#
# The tutorials' site and their catalogue are this repository's, so this is its command, not one of the kit's verbs.
#
#   catalogue                   prints the catalogue of the top-level tutorials, the body of a region in
#                               kit/modules/tutorials.yml.
#   site <ref>                  says which copy of the site a ref builds, as four key=value lines that GITHUB_OUTPUT
#                               reads: line, the line of kit; directory, the copy's directory on the gh-pages branch;
#                               base, the path it is served at, the build's TUTORIALS_BASE; and url, its address. The
#                               ref is main or a release tag, release/<version>; any other is refused.
#   publish <directory> <dist>  replaces <directory> of the gh-pages branch with the built site <dist>, in one
#                               commit, and pushes it. Only a runner publishes, from the tutorials workflow.
#   answers <url>               asks an address until it answers 200, and fails when it never does. The tutorials
#                               workflow runs it after publish, on the copy's address, so a copy that Pages does
#                               not serve fails the run that published it. It writes nothing, and runs anywhere.
#   retire [--dry-run]          removes the copy of each pre-release whose tag is gone, in one commit, and pushes
#                               it. Only a runner retires; with --dry-run it says what it would remove, anywhere.
#
# The catalogue. kit tutorials lists the tutorials from kit/modules/tutorials.yml, and that file's catalogue region is
# this script's output, so the list is never typed twice: a page's front matter is the only place a tutorial is
# described. Run `kit generate kit/modules/tutorials.yml` to rewrite the region; `kit generate --check` fails when it
# is stale.
#
# The tutorials are of two kinds. An online tutorial is a top-level page of the site: a page with `top: true`, at
# <id>/index.mdx under the project's src/content/, listed with its path on the site. A tutorial that ships with the kit
# is a markdown page, <id>.md under kit/modules/tutorials/, which kit tutorials reads on this machine, listed with its
# file, from modules/. Each kind has the same front matter. The catalogue holds the audiences, each its id, label, and
# color, in the order projects/tutorials/audiences.yml lists them, and the tutorials of both kinds sorted by `order`
# (1000 when a page has none), then id. A file that cannot be listed is refused, naming the file and why, and the exit
# status is 1: an audience without a color shaped #rrggbb; a tutorial's page lacking a title, a summary, a glyph, or
# an audience; one with an audience that audiences.yml does not list; a top-level page that is not at
# <id>/index.mdx; or a second page of an id, online or shipped, which names both files.
#
# TUTORIALS_PROJECT names the project, projects/tutorials by default, and TUTORIALS_SHIPPED the directory of the pages
# that ship with the kit, kit/modules/tutorials by default, where none is no error; the tests point both at fixtures.
#
# The site. GitHub Pages serves the gh-pages branch of this repository, and each copy of the site is one directory of
# it: tutorials/main/ for the default branch, tutorials/<major>.<minor>/ for a release, one copy for every patch
# release of the line, and tutorials/<version>/ for a pre-release, its own. kit opens a tutorial at the address
# modules/bash/tutorials.sh names for its version, and site reads the line and the address there, so the copy a ref
# builds is the one that ref's kit opens. On a runner, site refuses a repository whose Pages are at another address
# than the one kit opens.
#
# publish asks the branch as it stands, replaces the one directory whole, leaves every other copy as it is, keeps an
# empty .nojekyll at the root, so Pages serves the files as they are, and, for tutorials/main, copies the build's
# 404.html to the root, the page Pages serves for an address with no file. A build that changes nothing commits
# nothing. A push the repository refuses, as when another copy landed first, starts again from the branch as it then
# stands, five times at most. git pushes, with the credentials `gh auth setup-git` gives it for the runner's token.
#
# answers asks with curl, following a redirect, 30 times at most, 10 seconds apart, since Pages takes a while to
# serve a branch it was just pushed. TUTORIALS_TRIES and TUTORIALS_PAUSE replace the two numbers; the tests set the
# pause to 0.
#
# TUTORIALS_PAGES names the repository whose gh-pages branch is written, origin's by default; the tests point it at a
# repository of their own. A <dist> that is not absolute is read from the repository's root.
#
# Exits 0 when it did what it says, 1 on a refusal, and 2 on a usage error.
#
# see: .github/workflows/tutorials.yml, .github/workflows/retire-pre-releases.yml, projects/tutorials/README.md

set -o errexit -o nounset -o pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

project=${TUTORIALS_PROJECT:-projects/tutorials}
content=${project}/src/content
shipped=${TUTORIALS_SHIPPED:-kit/modules/tutorials}

# owners holds each listed page's id and file, one a line, each line after a newline, so a second page of an id is
# refused, naming the first.
owners=$'\n'

# refuse <file> <reason> says why a page cannot be listed, and stops.
refuse() {
  printf '❌ %s: %s\n' "$1" "$2" >&2
  exit 1
}

# row <file> <front> <noun> <top> <shaped> <id> <key> <value> prints the page's row of the catalogue, JSON, its
# <key> <value> the page's path on the site or its file, or refuses it, calling it <noun>. With <top> true, a page
# whose front matter, the JSON <front>, lacks top: true is skipped, printing nothing, and one that is not <shaped> at
# <id>/index.mdx is refused. Then a page is refused that lacks a title, a summary, a glyph, or an audience, or names
# an audience that audiences.yml does not list. One jq judges the page and makes its row, where a jq a question would
# start a process for each. It reads audiences.
row() {
  local file=$1 front=$2 noun=$3 said owner
  # shellcheck disable=SC2016  # the program is jq's, not the shell's
  said=$(jq -r --argjson audiences "${audiences}" --argjson top "$4" --argjson shaped "$5" --arg id "$6" \
    --arg key "$7" --arg value "$8" '
    def has_text($field): try (.[$field] | type == "string" and length > 0) catch false;
    if $top and ((try (.top // false) catch false) | tostring) != "true" then "skip"
    elif $top and ($shaped | not) then "refuse\ta top-level page lives at <id>/index.mdx"
    else
      . as $front
      | (first(("title", "summary", "glyph") | select(. as $field | $front | has_text($field) | not)) // null) as $lacks
      | if $lacks then "refuse\tneeds a \($lacks)"
        elif (try (.audience | type == "array" and length > 0) catch false) | not then "refuse\tneeds an audience"
        else
          (first(.audience[] | select(. as $a | $audiences | map(.id) | index($a) | not)) // null) as $unknown
          | if $unknown != null then "unknown\t\($unknown)"
            else "row\t" + ({id: $id, ($key): $value, title, summary, glyph, audience, order: (.order // 1000)}
              | tojson)
            end
        end
    end' <<< "${front}")
  case "${said}" in
    (skip) ;;
    (refuse$'\t'needs*) refuse "${file}" "${noun} ${said#*$'\t'}" ;;
    (refuse$'\t'*) refuse "${file}" "${said#*$'\t'}" ;;
    (unknown$'\t'*) refuse "${file}" "the audience '${said#*$'\t'}' is not in ${project}/audiences.yml" ;;
    (*)
      case "${owners}" in
        (*$'\n'"$6"$'\t'*)
          owner=${owners#*$'\n'"$6"$'\t'}
          refuse "${file}" "the id '$6' is already listed by ${owner%%$'\n'*}"
      esac
      owners+="$6"$'\t'"${file}"$'\n'
      pages+=("${said#*$'\t'}")
  esac
}

# catalogue prints the region's body, YAML, on stdout.
catalogue() {
  local audiences pages=() file front id shaped
  audiences=$(yq -p yaml -o json '.' "${project}/audiences.yml")
  # shaped is the first audience with no color, its id after "none", or else the first whose color is not #rrggbb: its
  # id, a tab, and the color
  shaped=$(jq --raw-output '(first(.[] | select((.color // "") == "") | "none\t\(.id)")
    // first(.[] | select(.color | type != "string" or (test("^#[0-9A-Fa-f]{6}$") | not)) | "\(.id)\t\(.color)"))
    // empty' <<< "${audiences}")
  [[ "${shaped}" != none$'\t'* ]] \
    || refuse "${project}/audiences.yml" "the audience '${shaped#none$'\t'}' needs a color, as #rrggbb"
  [[ -z "${shaped}" ]] || refuse "${project}/audiences.yml" \
    "the audience '${shaped%%$'\t'*}' has the color '${shaped#*$'\t'}', not #rrggbb"

  while IFS= read -r file
  do
    front=$(yq -p yaml --front-matter=extract -o json '.' "${file}") || refuse "${file}" 'front matter that does not parse'
    id=${file#"${content}/"}
    shaped=false
    [[ ! "${id}" =~ ^[^/]+/index\.mdx$ ]] || shaped=true
    id=${id%/index.mdx}
    row "${file}" "${front}" 'a top-level page' true "${shaped}" "${id}" path "${id}/"
  done < <(find "${content}" -type f -name '*.mdx' | LC_ALL=C sort)

  # the pages that ship with the kit, each at <id>.md
  while IFS= read -r file
  do
    front=$(yq -p yaml --front-matter=extract -o json '.' "${file}") || refuse "${file}" 'front matter that does not parse'
    id=${file##*/}
    id=${id%.md}
    row "${file}" "${front}" 'a tutorial' false true "${id}" file "tutorials/${id}.md"
  done < <([[ ! -d "${shipped}" ]] || find "${shipped}" -maxdepth 1 -type f -name '*.md' | LC_ALL=C sort)

  # shellcheck disable=SC2016  # the program is jq's, not the shell's
  printf '%s\n' "${pages[@]+"${pages[@]}"}" \
    | jq -s --argjson audiences "${audiences}" \
      '{audiences: ($audiences | map({id, label, color})), tutorials: sort_by([.order, .id])}' \
    | yq -p json -o yaml -P '.'
}

usage() {
  echo "usage: bin/tutorials catalogue | site <ref> | publish <directory> <dist> | answers <url> |" \
    "retire [--dry-run]" >&2
}

# site <ref> prints the copy of the site a ref builds: its line, its directory on the branch, its base path, and its
# address. The address is modules/bash/tutorials.sh's, whatever KIT_TUTORIALS_BASE says: that one is for a site
# served on this machine. Pages serves a repository's branch at https://<owner>.github.io/<repository>/, so the
# directory is the address's path after the repository.
site() {
  local ref=$1 version='' line address path directory pages
  case "${ref}" in
    (main) version=$(release:unreleased) ;;
    (release/*) ! releases:valid "${ref#release/}" || version=${ref#release/} ;;
  esac
  if [[ -z "${version}" ]]
  then
    error "'${ref}' has no copy of the tutorials: main and a release tag have one"
    exit 1
  fi
  line=$(tutorials:line "${version}")
  address=$(tutorials:site)
  path=/${address#*://*/}
  directory=${path#/*/}${line}
  if [[ -n "${GITHUB_REPOSITORY:-}" ]]
  then
    pages=https://${GITHUB_REPOSITORY%%/*}.github.io/${GITHUB_REPOSITORY#*/}/
    if [[ "${address,,}" != "${pages,,}"* ]]
    then
      error "kit opens its tutorials at ${address}, and the Pages of ${GITHUB_REPOSITORY} are at ${pages}:" \
        "nothing is built for an address kit never opens"
      exit 1
    fi
  fi
  printf '%s\n' "line=${line}" "directory=${directory}" "base=${path}${line}/" "url=${address}${line}/"
}

# on-runner refuses a desk: the site is published, and a copy retired, by a workflow and nowhere else.
on-runner() {
  [[ -z "${GITHUB_ACTIONS:-}" ]] || return 0
  error "the tutorials are published by the tutorials workflow, not from a desk: it runs on a push to main and of" \
    "a release tag, and a deleted branch retires the copies of its pre-releases"
  exit 1
}

# branch <into> makes <into> a repository on the gh-pages branch as the pages repository has it now, one commit deep,
# or on an empty gh-pages where the repository has none yet. It returns 1 when the repository does not answer. It
# reads pages.
branch() {
  local into=$1 status=0
  git ls-remote --exit-code --heads "${pages}" gh-pages >/dev/null || status=$?
  (( status == 0 || status == 2 )) || return 1
  git init --quiet --initial-branch=gh-pages "${into}" || return 1
  git -C "${into}" remote add origin "${pages}" || return 1
  (( status == 0 )) || return 0
  git -C "${into}" fetch --quiet --depth 1 origin gh-pages && git -C "${into}" reset --quiet --hard FETCH_HEAD
}

# land <change> changes the gh-pages branch in one commit, and pushes it. <change> is a function: it is given a copy
# of the branch, edits the files there, and sets subject, the commit's. land sets landed: yes when the commit is on
# the branch, and no when the change left the branch as it is, so nothing was committed, or when dry is set, where it
# stops after the change. A push the repository refuses is tried again, on a fresh copy of the branch as it then
# stands, five times at most; then it says what git said, and exits 1. Call it as a plain command, never in a
# condition, where bash would let a step of it fail unseen. It reads pages, dry, and refused.
land() {
  local change=$1 scratch copy try
  scratch=$(mktemp -d)
  # shellcheck disable=SC2064  # expanded now on purpose: the path is fixed from here on
  trap "rm -rf '${scratch}'" EXIT
  for try in 1 2 3 4 5
  do
    copy=${scratch}/${try}
    if ! branch "${copy}"
    then
      error "${pages} did not answer for its gh-pages branch; nothing is changed there"
      exit 1
    fi
    "${change}" "${copy}"
    landed=no
    [[ -z "${dry}" ]] || return 0
    git -C "${copy}" add --all
    ! git -C "${copy}" diff --cached --quiet || return 0
    git -C "${copy}" -c user.name='github-actions[bot]' \
      -c user.email='41898282+github-actions[bot]@users.noreply.github.com' -c commit.gpgsign=false \
      commit --quiet --message "${subject}"
    landed=yes
    ! git -C "${copy}" push --quiet origin gh-pages 2> "${scratch}/refusal" || return 0
  done
  cat "${scratch}/refusal" >&2
  error "${refused}: the push to gh-pages was refused ${try} times"
  exit 1
}

# replace-copy <copy> is publish's change: it replaces the directory whole with the built site, keeps the empty
# .nojekyll, and gives the root main's 404.html. It reads directory and dist.
replace-copy() {
  rm -rf "${1:?}/${directory}"
  mkdir -p "$1/${directory}"
  cp -R "${dist}/." "$1/${directory}/"
  : > "$1/.nojekyll"
  [[ "${directory}" != tutorials/main ]] || cp "${dist}/404.html" "$1/404.html"
  subject="${directory}: the site as built${GITHUB_SHA:+ at ${GITHUB_SHA}}"
}

# retire-copies <copy> is retire's change: it removes each tutorials/<version>-<suffix> whose tag,
# release/<version>-<suffix>, the pages repository no longer has, and lists them in retired. It reads live, the tags
# the repository has, each by its ref.
retire-copies() {
  local path name
  retired=()
  for path in "$1"/tutorials/*/
  do
    name=${path%/}
    name=${name##*/}
    [[ "${name}" =~ ^[0-9]+\.[0-9]+\.[0-9]+-.+$ ]] || continue
    ! list:among "refs/tags/release/${name}" "${live[@]}" || continue
    rm -rf "${path}"
    retired+=("tutorials/${name}")
  done
  subject="retired: ${retired[*]}"
}

verb=${1:-}
case "${verb}" in
  (catalogue)
    (( $# == 1 )) || { usage; exit 2; }
    catalogue
    exit 0
    ;;
  (site | publish | answers | retire) ;;
  (*) usage; exit 2
esac
shift

# catalogue, which kit generate runs, needs none of the kit's modules; the rest take its messages from them, and site
# the tutorials' address.
# shellcheck source=SCRIPTDIR/../kit/modules/bash/1st.sh
source kit/modules/bash/1st.sh
dry=''

case "${verb}" in
  (site)
    (( $# == 1 )) || { usage; exit 2; }
    use tutorials releases
    site "$1"
    ;;
  (publish)
    (( $# == 2 )) || { usage; exit 2; }
    directory=$1
    dist=$2
    [[ "${directory}" =~ ^tutorials/[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || { usage; exit 2; }
    on-runner
    needs=(index.html)
    [[ "${directory}" != tutorials/main ]] || needs+=(404.html)
    for page in "${needs[@]}"
    do
      if [[ ! -f "${dist}/${page}" ]]
      then
        error "no built site at ${dist}: it has no ${page}"
        exit 1
      fi
    done
    guard:require tool:git tool:gh || exit 1
    pages=${TUTORIALS_PAGES:-$(git remote get-url origin)}
    gh auth setup-git
    step "publishing ${directory} to the gh-pages branch of ${pages}"
    refused="${directory} is not published"
    land replace-copy
    if [[ "${landed}" == yes ]]
    then
      ok "published ${directory}"
      summary "✅ Published ${directory} to the gh-pages branch."
    else
      ok "${directory} is as published: the build changed nothing"
      summary "✅ ${directory} is as published: the build changed nothing."
    fi
    ;;
  (answers)
    (( $# == 1 )) || { usage; exit 2; }
    url=$1
    [[ "${url}" =~ ^https?://[^[:space:]]+$ ]] || { usage; exit 2; }
    guard:require tool:curl || exit 1
    tries=${TUTORIALS_TRIES:-30}
    answer=''
    for (( try = 1; try <= tries; try++ ))
    do
      # curl prints 000 where nothing answered, and fails
      answer=$(curl --silent --location --output /dev/null --write-out '%{http_code}' --max-time 10 "${url}") || true
      [[ "${answer}" != 200 ]] || break
      (( try == tries )) || sleep "${TUTORIALS_PAUSE:-10}"
    done
    if [[ "${answer}" != 200 ]]
    then
      said="its last answer was ${answer}"
      [[ "${answer}" =~ ^[1-9][0-9]*$ ]] || said='it gave no answer at all'
      error "${url} did not answer 200 in ${tries} tries; ${said}. Where the copy is on the gh-pages branch, Pages" \
        "does not serve it: an owner of the repository turns Pages on once, as projects/tutorials/README.md says" \
        "under Publishing"
      summary "### ❌ ${url} did not answer 200 in ${tries} tries; ${said}." \
        'An owner of the repository turns Pages on once: see Publishing in projects/tutorials/README.md.'
      exit 1
    fi
    ok "${url} answers"
    summary "✅ ${url} answers."
    ;;
  (retire)
    (( $# <= 1 )) || { usage; exit 2; }
    [[ $# -eq 0 || "$1" == --dry-run ]] || { usage; exit 2; }
    dry=${1:-}
    [[ -n "${dry}" ]] || on-runner
    guard:require tool:git || exit 1
    pages=${TUTORIALS_PAGES:-$(git remote get-url origin)}
    if [[ -z "${dry}" ]]
    then
      guard:require tool:gh || exit 1
      gh auth setup-git
    fi
    # a pre-release's copy goes when its tag is gone; when the tags cannot be read, nothing is retired
    if ! list:read live git ls-remote --tags --refs "${pages}" 'refs/tags/release/*'
    then
      error "${pages} did not answer for its tags; nothing is retired"
      exit 1
    fi
    live=("${live[@]##*$'\t'}")
    retired=()
    refused='no copy is retired'
    land retire-copies
    for directory in "${retired[@]}"
    do
      step "${dry:+would have }retired ${directory}: the tag release/${directory#tutorials/} is gone"
    done
    ok "copies of the tutorials ${dry:+that would be }retired: ${#retired[@]}"
    [[ -n "${dry}" ]] || summary "✅ Copies of the tutorials retired: ${#retired[@]}."
esac

# ----------------------------------------------------------------------------------------------------------------------
