#!/usr/bin/env bash
# build - builds the repository tests/model-reality.bats holds the model to
# ----------------------------------------------------------------------------------------------------------------------
# build <dir> makes, under <dir>, which it creates, a repository with every case the model names, so the test finds
# what git writes for each:
#
#   - repo: the desk, on main, whose origin is origin.git until the last step points it at github.com/o/r:
#     - a root commit of a file, an executable, a symlink, and a nested directory, and a kit.yml whose facts.read
#       names README.md
#     - a commit whose message has a body and the trailers Co-Authored-By and Refs
#     - a merge of the branch side, and a merge of the signed tag r1 of the branch release, which writes mergetag
#     - a commit signed with an SSH key, and one written with i18n.commitEncoding, an encoding header
#     - the annotated tag v1, the signed tag v2, and the lightweight tag wip
#     - the submodule sub, from the repository sub
#     - the branch extra, whose commit holds a header git does not know, written with git hash-object --literally
#     - the branch local-up, whose upstream is main of this repository, branch.local-up.remote = .
#     - a note on main, a stash with an untracked file, and planned.md, added with --intent-to-add
#     - remote.origin with a url, a pushurl, and two fetch refspecs; refs/remotes/origin/HEAD on main
#     - remote.origin.gh-resolved, as gh writes it, and branch.feature.vscode-merge-base, as VS Code writes it: keys
#       git does not document
#     - user.name, user.email, and user.signingkey; gpg.format ssh and the allowed signers file; and
#       extensions.worktreeConfig, with user.email in the desk's config.worktree
#   - worktrees/feature: a linked worktree on feature, whose upstream is origin/feature, one commit pushed and one not
#   - worktrees/detached: a linked worktree on a detached HEAD
#   - worktrees/locked: a linked worktree on locked-work, locked with a reason
#   - worktrees/unborn: a linked worktree on unborn, a branch with no commit yet
#   - worktrees/gone: a linked worktree whose directory is removed, so git worktree prune would remove it too
#   - conflict: a clone of origin.git stopped in a merge, c1.txt in conflict, stages 1 to 3, and c2.txt resolved, so
#     its index holds resolve-undo; it names the allowed signers file, so git log %G? checks its signed commit
#   - ssh: the key that signs, and the allowed signers file
#
# git reads no configuration but the repositories' own, and HOME is <dir>/home, so the desk's files never reach it.
# Every commit has one fixed author and committer. Nothing reaches the network.

set -o errexit -o nounset -o pipefail

# The fixture needs git worktree add --orphan, from git 2.42, and ssh-keygen, which signs its commits and tags.
version=$(git version)
version=${version#git version }
IFS=. read -r major minor _ <<<"${version}"
if (( major < 2 || ( major == 2 && minor < 42 ) ))
then
  echo "build: needs git 2.42 or later (worktree add --orphan); this is git ${version}" >&2
  exit 1
fi
if ! command -v ssh-keygen >/dev/null
then
  echo "build: needs ssh-keygen, which signs the fixture's commits and tags, and it is not on PATH" >&2
  exit 1
fi

dir=$1
mkdir -p "${dir}"
dir=$(cd "${dir}" && pwd -P)
export HOME="${dir}/home" GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME='Ada Model' GIT_AUTHOR_EMAIL=ada@example.com
export GIT_COMMITTER_NAME='Ada Model' GIT_COMMITTER_EMAIL=ada@example.com
# shellcheck disable=SC2046  # git lists names, one a line, none with a space
unset $(git rev-parse --local-env-vars)
mkdir -p "${HOME}" "${dir}/ssh" "${dir}/worktrees"

# The key that signs, and the file that lets git check what it signed.
ssh-keygen -q -t ed25519 -N '' -C ada@example.com -f "${dir}/ssh/key"
printf 'ada@example.com namespaces="git" %s\n' "$(cat "${dir}/ssh/key.pub")" > "${dir}/ssh/allowed-signers"

# The submodule's own repository.
git init --quiet --initial-branch=main "${dir}/sub"
printf 'sub\n' > "${dir}/sub/sub.txt"
git -C "${dir}/sub" add sub.txt
git -C "${dir}/sub" commit --quiet --message 'the submodule'

git init --quiet --bare --initial-branch=main "${dir}/origin.git"
git clone --quiet "${dir}/origin.git" "${dir}/repo" 2>/dev/null
cd "${dir}/repo"
git config user.name 'Ada Model'
git config user.email ada@example.com
git config user.signingkey "${dir}/ssh/key.pub"
git config gpg.format ssh
git config gpg.ssh.allowedSignersFile "${dir}/ssh/allowed-signers"
git config core.repositoryformatversion 1
git config extensions.worktreeConfig true
git config --worktree user.email desk@example.com

# The root commit: a file, an executable, a symlink, and a nested directory.
mkdir -p bin docs/deep/nested
printf '# model\n' > README.md
printf '#!/bin/sh\necho run\n' > bin/run
chmod +x bin/run
printf 'nested\n' > docs/deep/nested/file.md
ln -s README.md link
printf 'facts:\n  read:\n    - README.md\n' > kit.yml
git add README.md bin/run docs link kit.yml
git commit --quiet --message '#1 start: the first files'

printf 'two\n' > two.txt
git add two.txt
git commit --quiet --message '#2 docs: a body and trailers

The body says why the commit is made.

Co-Authored-By: Bea Model <bea@example.com>
Refs: #1'
git push --quiet --set-upstream origin main 2>/dev/null
git remote set-head origin main

# A merge of two branches.
git switch --quiet --create side
printf 'side\n' > side.txt
git add side.txt
git commit --quiet --message '#3 side: a file of the side branch'
git switch --quiet main
printf 'main\n' > main.txt
git add main.txt
git commit --quiet --message '#3 main: a file of main'
git merge --quiet --no-ff --no-edit side

# A signed commit, and one with an encoding header.
printf 'signed\n' > signed.txt
git add signed.txt
git commit --quiet --gpg-sign --message '#4 signed: a commit signed with an SSH key'
git -c i18n.commitEncoding=ISO-8859-1 commit --quiet --allow-empty --message '#5 encoded: a message in ISO-8859-1'

# A merge of a signed tag, which embeds the tag in a mergetag header.
git switch --quiet --create release
printf 'release\n' > release.txt
git add release.txt
git commit --quiet --message '#6 release: the release branch'
git tag --sign --message 'release 1, signed' r1
git switch --quiet main
git merge --quiet --no-ff --no-edit r1

# The three kinds of tag.
git tag --annotate --message 'version 1' v1 HEAD~1
git tag --sign --message 'version 2, signed' v2
git tag wip HEAD~2

git -c protocol.file.allow=always submodule --quiet add "${dir}/sub" sub
git commit --quiet --message '#7 sub: the submodule'
git push --quiet origin main 2>/dev/null

# A commit with a header git does not know, which only hash-object --literally writes.
extra=$(printf 'tree %s\nparent %s\nauthor %s\ncommitter %s\nx-model-extra a header git does not know\n\n%s\n' \
  "$(git rev-parse 'HEAD^{tree}')" "$(git rev-parse HEAD)" "Ada Model <ada@example.com> 1790000000 +0000" \
  "Ada Model <ada@example.com> 1790000000 +0000" '#8 extra: a commit with an unknown header' \
  | git hash-object -t commit -w --literally --stdin)
git branch extra "${extra}"

# A linked worktree on a branch with an upstream, one commit pushed and one not.
git worktree add --quiet -b feature "${dir}/worktrees/feature"
printf 'feature\n' > "${dir}/worktrees/feature/feature.txt"
git -C "${dir}/worktrees/feature" add feature.txt
git -C "${dir}/worktrees/feature" commit --quiet --message '#9 feature: the pushed commit

Refs: #9'
git -C "${dir}/worktrees/feature" push --quiet --set-upstream origin feature 2>/dev/null
printf 'more\n' >> "${dir}/worktrees/feature/feature.txt"
git -C "${dir}/worktrees/feature" commit --quiet --all --message '#9 feature: the commit not pushed

Co-Authored-By: Bea Model <bea@example.com>'

# A detached linked worktree, a locked one, one on a branch with no commit yet, and one whose directory is gone.
git worktree add --quiet --detach "${dir}/worktrees/detached" HEAD~1
git worktree add --quiet -b locked-work "${dir}/worktrees/locked"
git worktree lock --reason 'kept for the model' "${dir}/worktrees/locked"
git worktree add --quiet --orphan -b unborn "${dir}/worktrees/unborn"
git worktree add --quiet --detach "${dir}/worktrees/gone" HEAD
rm -rf "${dir}/worktrees/gone"

# A branch whose upstream is a branch of this repository.
git branch --quiet --track local-up main

# A note, a stash with an untracked file, and a path added with --intent-to-add.
git notes add --message 'a note on main' main
printf 'changed\n' >> README.md
printf 'untracked\n' > loose.txt
git stash push --quiet --include-untracked --message 'model stash'
printf 'planned\n' > planned.md
git add --intent-to-add planned.md

# A clone stopped in a merge: c1.txt in conflict, and c2.txt resolved, which records resolve-undo.
git clone --quiet "${dir}/origin.git" "${dir}/conflict" 2>/dev/null
cd "${dir}/conflict"
git config gpg.ssh.allowedSignersFile "${dir}/ssh/allowed-signers"
printf 'base\n' > c1.txt
printf 'base\n' > c2.txt
git add c1.txt c2.txt
git commit --quiet --message '#10 conflict: the base'
git switch --quiet --create theirs
printf 'theirs\n' > c1.txt
printf 'theirs\n' > c2.txt
git commit --quiet --all --message '#10 conflict: theirs'
git switch --quiet main
printf 'ours\n' > c1.txt
printf 'ours\n' > c2.txt
git commit --quiet --all --message '#10 conflict: ours'
if git merge --quiet theirs >/dev/null 2>&1
then
  echo "build: the merge of theirs did not stop in a conflict" >&2
  exit 1
fi
git add c2.txt

# The remote last: a second fetch refspec, a push URL, and a GitHub URL that nothing fetches. gh and VS Code each record
# a key git does not document, in the remote's and in a branch's section.
cd "${dir}/repo"
git config --add remote.origin.fetch '+refs/notes/*:refs/notes/origin/*'
git config remote.origin.gh-resolved base
git config branch.feature.vscode-merge-base origin/main
git remote set-url origin https://github.com/o/r.git
git remote set-url --push origin git@github.com:o/r.git

# ----------------------------------------------------------------------------------------------------------------------
