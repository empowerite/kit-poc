# a native entity's relations, its fields of an entity type, and a native sum's variants go to native entities or stubs;
# each that goes to a logical entity is a finding that names the entity, and a logical entity may relate to anything
import "model" as model; model::build | model::check
{"files": [{"domain": "git", "origin": "release", "path": "g.yml", "doc": {"entity": "G", "layer": "native", "tool": "git", "fields": {"w": {"type": "L", "status": "unused"}, "n": {"type": "H", "status": "unused"}}, "relations": {"up": {"to": "L", "arity": "many", "derived": "x"}, "peer": {"to": "G", "derived": "x"}, "far": {"to": "S", "derived": "x"}}}}, {"domain": "git", "origin": "release", "path": "h.yml", "doc": {"entity": "H", "layer": "native", "tool": "git", "sum": true, "variants": {"Up": {"l": "L"}, "Same": {"g": "G"}}}}, {"domain": "code", "origin": "release", "path": "l.yml", "doc": {"entity": "L", "layer": "logical", "over": ["G"], "relations": {"g": {"to": "G", "derived": "x"}}}}, {"domain": "p", "origin": "release", "path": "s.yml", "doc": {"entity": "S", "stub": true}}]}
["G is native, and its field w has type L, which is logical; a native entity relates only to native entities and stubs", "G is native, and its relation up goes to L, which is logical; a native entity relates only to native entities and stubs", "H is native, and its variant Up holds L, which is logical; a native entity relates only to native entities and stubs"]

# ----------------------------------------------------------------------------------------------------------------------
# a repository's domain.yml: it adds layout hints to the release's domain, and sets nothing the release's sets
# ----------------------------------------------------------------------------------------------------------------------

# a later domain.yml adds the hints of entities the first gives none, and its name, its intro, and a hint the first
# gives are findings; the first's stand
import "model" as model; model::build | [model::check, .domains.code]
{"files": [{"domain": "code", "origin": "release", "path": "modules/model/code/domain.yml", "doc": {"name": "Code", "intro": "Source.", "layout": {"Commit": {"row": 0, "col": 0}}}}, {"domain": "code", "origin": "repository", "path": ".kit/model/code/domain.yml", "doc": {"name": "Hijacked", "intro": "Mine.", "layout": {"Commit": {"row": 3, "col": 3}, "Ticket": {"row": 1, "col": 0}}}}]}
[[".kit/model/code/domain.yml sets name on the domain code, which modules/model/code/domain.yml sets; a later domain.yml adds only layout hints", ".kit/model/code/domain.yml sets intro on the domain code, which modules/model/code/domain.yml sets; a later domain.yml adds only layout hints", ".kit/model/code/domain.yml gives a layout hint to Commit, which modules/model/code/domain.yml gives"], {"name": "Code", "intro": "Source.", "layout": {"Commit": {"row": 0, "col": 0}, "Ticket": {"row": 1, "col": 0}}}]

# a repository's domain.yml for a domain the release does not have defines it, and needs a name and an intro
import "model" as model; model::build | [model::check, .domains]
{"files": [{"domain": "mine", "origin": "repository", "path": ".kit/model/mine/domain.yml", "doc": {"name": "Mine", "layout": {"T": {"row": 0, "col": 1}}}}]}
[[".kit/model/mine/domain.yml has no intro; the domain.yml that defines a domain gives its name and intro"], {"mine": {"name": "Mine", "layout": {"T": {"row": 0, "col": 1}}}}]

# a key a domain.yml does not have, a layout that is not a mapping, and a hint that is not {row, col} of whole numbers
# from 0 are findings; the hints that hold stand
import "model" as model; model::build | [model::check, .domains]
{"files": [{"domain": "a", "origin": "release", "path": "a/domain.yml", "doc": {"name": "A", "intro": "x", "colour": "red", "layout": {"P": {"row": 0, "col": 0}, "Q": {"row": -1, "col": 0}, "R": {"row": 0.5, "col": 0}, "S": {"row": 0}, "T": {"row": 0, "col": 0, "span": 2}, "bad": {"row": 0, "col": 0}}}}, {"domain": "b", "origin": "release", "path": "b/domain.yml", "doc": {"name": "B", "intro": "y", "layout": ["P"]}}]}
