# a sentence of a page is wrapped into lines of at most 118 characters, a newline in it is a space, and a < or a * outside
# a code span is escaped, in a cell too; a code span is left as it is
import "model" as model; model::build | model::page("lab")
{"files": [{"domain": "lab", "origin": "release", "path": "m/lab/domain.yml", "doc": {"name": "Lab", "intro": "one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen twenty\nand more"}}, {"domain": "lab", "origin": "release", "path": "c.yml", "doc": {"entity": "Commit", "layer": "logical", "means": "Named <name>, matching a * and `<code> *`.", "fields": {"id": {"type": "Hash", "means": "the <id>"}}}}]}
"one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen\nnineteen twenty and more\n\n![Lab: the entities of the domain and how they relate](lab.svg)\n\n## Relations\n\n| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |\n\n## Entities\n\n### Commit\n\nNamed \\<name>, matching a \\* and `<code> *`.\n\nLayer: logical\n\n| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| id | Hash | 1 | stored |  |  | the \\<id> |"


# a paragraph that opens with a block marker is escaped so it stays a paragraph: a list marker, a heading, a quote, a rule,
# a fence, a table bar, and an ordered number
import "model" as model; map(model::paragraph(20))
["- a", "+ a", "> a", "# a", "1. a", "2) a", "=== a", "--- a", "~~~ a", "```js a", "| a", "plain a"]
["\\- a", "\\+ a", "\\> a", "\\# a", "1\\. a", "2\\) a", "\\=== a", "\\--- a", "\\~~~ a", "\\`\\`\\`js a", "\\| a", "plain a"]

# a word that opens with the block marker - is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd - item"]
["aaaa bbbb cccc\ndddd - item"]

# a word that opens with the block marker + is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd + item"]
["aaaa bbbb cccc\ndddd + item"]

# a word that opens with the block marker > is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd > item"]
["aaaa bbbb cccc\ndddd > item"]

# a word that opens with the block marker # is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd # item"]
["aaaa bbbb cccc\ndddd # item"]

# a word that opens with the block marker 1. is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd 1. item"]
["aaaa bbbb cccc\ndddd 1. item"]

# a word that opens with the block marker 2) is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd 2) item"]
["aaaa bbbb cccc\ndddd 2) item"]

# a word that opens with the block marker === is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd === item"]
["aaaa bbbb cccc\ndddd === item"]

# a word that opens with the block marker --- is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd --- item"]
["aaaa bbbb cccc\ndddd --- item"]

# a word that opens with the block marker ~~~ is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd ~~~ item"]
["aaaa bbbb cccc\ndddd ~~~ item"]

# a word that opens with backticks no span closes is escaped, so it may open a line
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd ```js item"]
["aaaa bbbb cccc dddd\n\\`\\`\\`js item"]

# a word that opens with the block marker | is never put at the start of a line: the word before it goes down with it
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd | item"]
["aaaa bbbb cccc\ndddd | item"]

# a code span is one word, though it holds spaces, and a block marker inside it is no marker; the span is never split
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc `x y z` ee", "aaaa bbbb cccc dd `a - b` ee"]
["aaaa bbbb cccc\n`x y z` ee", "aaaa bbbb cccc dd\n`a - b` ee"]

# runs of spaces are one, and none starts or ends a line
import "model" as model; map(model::paragraph(3))
["a  b   c", "  a  ", "a\n\nb"]
["a b\nc", "a", "a b"]

# a word longer than the width, and a URL, stand alone on a line of their own
import "model" as model; map(model::paragraph(20))
["ab abcdefghijklmnopqrstuvwxyz cd", "see https://example.com/a/very/long/path ok"]
["ab\nabcdefghijklmnopqrstuvwxyz\ncd", "see\nhttps://example.com/a/very/long/path\nok"]

# prose escapes a backslash first, then a < and a * outside code spans; code spans pair by the length of their backtick runs,
# and an unmatched run is text, escaped
import "model" as model; map(model::prose)
["unmatched ` tick <z>", "``a ` b <c>`` <d>", "a\\|b", "a\\<b", "x\\", "a*b `c*d` e*f", "`a <b>` `` `c <d>` `` <e>"]
["unmatched \\` tick \\<z>", "``a ` b <c>`` \\<d>", "a\\\\|b", "a\\\\\\<b", "x\\\\", "a\\*b `c*d` e\\*f", "`a <b>` `` `c <d>` `` \\<e>"]

# a relation's text is escaped in the table: < and *, a | as \|, and a backslash as two, so the cell keeps its pipes
import "model" as model; model::build | model::relations("code")
{"files": [{"domain": "code", "origin": "release", "path": "a.yml", "doc": {"entity": "A", "layer": "logical", "relations": {"r": {"to": "A", "derived": "a <b> * c | d \\e"}, "s": {"to": "A", "derived": "x", "means": "1 \\| 2 \\<"}}}}]}
"| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |\n| A.r | A | 1 |  | derived | derived: a \\<b> \\* c \\| d \\\\e |\n| A.s | A | 1 |  | derived | derived: x. 1 \\\\\\| 2 \\\\\\< |"

# a held field's read-by is a code span, so the stars of a path stay stars
import "model" as model; model::build | model::fields("A")
{"files": [{"domain": "code", "origin": "release", "path": "a.yml", "doc": {"entity": "A", "layer": "logical", "fields": {"n": {"type": "Text", "status": "held", "read-by": "workspaces *.name.*"}, "m": {"type": "Text", "status": "planned"}}}}]}
"| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| m | Text | 1 | stored | planned |  |  |\n| n | Text | 1 | stored | held | `workspaces *.name.*` |  |"

# an underscore outside a code span is escaped, as a star is, so a line of them is no thematic break and a pair is no emphasis; one in a code span stays
import "model" as model; map(model::prose)
["___", "_ _ _", "a_b _c_ `d_e`"]
["\\_\\_\\_", "\\_ \\_ \\_", "a\\_b \\_c\\_ `d_e`"]

# a paragraph of underscores, or one that opens with them, stays a paragraph, and a line of them mid-paragraph does too
import "model" as model; map(model::paragraph(20))
["___", "_ _ _ a", "aaaa bbbb cccc dddd ___ item"]
["\\_\\_\\_", "\\_ \\_ \\_ a", "aaaa bbbb cccc dddd\n\\_\\_\\_ item"]

# a tab is a space: it opens no indented code, ends no line with a space, and leaves no tab in a table cell
import "model" as model; map(model::paragraph(20))
["\ta b", "a\tb", "a \t b\t"]
["a b", "a b", "a b"]

# a tab in a table cell is a space
import "model" as model; model::build | model::fields("A")
{"files": [{"domain": "code", "origin": "release", "path": "a.yml", "doc": {"entity": "A", "layer": "logical", "fields": {"n": {"type": "Text", "means": "a\tb\t c"}}}}]}
"| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| n | Text | 1 | stored |  |  | a b c |"

# a first word [x]: is escaped, so the paragraph is no definition or table row
import "model" as model; map(model::paragraph(20))
["[x]: url"]
["\\[x]: url"]

# a first word :-- is escaped, so the paragraph is no definition or table row
import "model" as model; map(model::paragraph(20))
[":-- a"]
["\\:-- a"]

# a first word :--: is escaped, so the paragraph is no definition or table row
import "model" as model; map(model::paragraph(20))
[":--: a"]
["\\:--: a"]

# a word [x]: is not put at the start of a line
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd [x]: item"]
["aaaa bbbb cccc\ndddd [x]: item"]

# a word :-- is not put at the start of a line
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd :-- item"]
["aaaa bbbb cccc\ndddd :-- item"]

# a word :-: is not put at the start of a line
import "model" as model; map(model::paragraph(20))
["aaaa bbbb cccc dddd :-: item"]
["aaaa bbbb cccc\ndddd :-: item"]

# a means or an intro that is only whitespace is no paragraph, and the page has no empty block
import "model" as model; model::build | model::page("lab")
