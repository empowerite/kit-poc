# ----------------------------------------------------------------------------------------------------------------------
# narrowing, the merge's leftovers, and entity: and extends: together
# ----------------------------------------------------------------------------------------------------------------------

# some and option do not narrow to each other, and many narrows to one
import "model" as model; model::build | [.findings, (.entities.C.fields | map_values(.arity))]
{"files": [{"domain": "code", "origin": "release", "path": "m/c.yml", "doc": {"entity": "C", "fields": {"a": {"type": "Text", "arity": "some"}, "b": {"type": "Text", "arity": "option"}, "c": {"type": "Text", "arity": "many"}}}}, {"domain": "mine", "origin": "repository", "path": "r/c.yml", "doc": {"extends": "C", "fields": {"a": {"arity": "option"}, "b": {"arity": "some"}, "c": {"arity": "one"}}}}]}
[["r/c.yml changes the arity of C.a from some to option, which does not narrow it", "r/c.yml changes the arity of C.b from option to some, which does not narrow it"], {"a": "some", "b": "option", "c": "one"}]

# two extensions narrow one member in turn, each from what the one before left: many to some, then some to option is
# a finding, though many holds option
import "model" as model; model::build | [.findings, .entities.C.fields.a.arity]
{"files": [{"domain": "code", "origin": "release", "path": "m/c.yml", "doc": {"entity": "C", "fields": {"a": {"type": "Text", "arity": "many"}}}}, {"domain": "mine", "origin": "repository", "path": "r/1.yml", "doc": {"extends": "C", "fields": {"a": {"arity": "some"}}}}, {"domain": "mine", "origin": "repository", "path": "r/2.yml", "doc": {"extends": "C", "fields": {"a": {"arity": "option"}}}}]}
[["r/2.yml changes the arity of C.a from some to option, which does not narrow it"], "some"]

# the check runs over what the merge left when it dropped members that are no mapping: the merge's findings, then the
# check's of what stands
import "model" as model; model::build | model::check
{"files": [{"domain": "code", "origin": "repository", "path": "r/a.yml", "doc": {"entity": "A", "layer": "logical", "fields": {"a": null, "b": {"type": "Ghost", "status": "planned"}}, "relations": {"r": "many", "s": {"to": "A", "derived": "x"}}}}]}
["r/a.yml gives A.a as something that is not a mapping of keys", "r/a.yml gives A.r as something that is not a mapping of keys", "A.b has type Ghost, which is not a scalar, an enum, or an entity"]

# an entity: null beside an extends: is an extension, and an entity: true beside one names both
import "model" as model; model::build | [.findings, (.entities | keys), .entities.C.fields]
{"files": [{"domain": "code", "origin": "release", "path": "m/c.yml", "doc": {"entity": "C"}}, {"domain": "mine", "origin": "repository", "path": "r/n.yml", "doc": {"entity": null, "extends": "C", "fields": {"n": {"type": "Text", "status": "planned"}}}}, {"domain": "mine", "origin": "repository", "path": "r/t.yml", "doc": {"entity": true, "extends": "C", "fields": {"t": {"type": "Text", "status": "planned"}}}}]}
[["r/t.yml names both an entity and an extension"], ["C"], {"n": {"type": "Text", "status": "planned"}}]

# ----------------------------------------------------------------------------------------------------------------------
# tables
# ----------------------------------------------------------------------------------------------------------------------

# an entity's fields are a table, one row to a field by name, with the arity as 1, 0..1, 0..*, or 1..*, an enum written out,
# a derived field's from before its means, a | escaped, and a newline made a space
import "model" as model; model::build | model::fields("Worktree")
{"files": [{"domain": "code", "origin": "release", "path": "w.yml", "doc": {"entity": "Worktree", "layer": "logical", "fields": {"tags": {"type": "Text", "arity": "many", "status": "unused", "means": "a | b\nc"}, "path": {"type": "Path", "source": "derived", "from": "the git dir", "status": "held", "read-by": "work path"}, "owner": {"type": "Person", "arity": "option", "status": "planned"}, "kind": {"type": {"enum": ["main", "linked"]}, "arity": "some", "status": "planned", "means": "which"}, "branch": {"type": "Text", "status": "held", "read-by": "worktree branch", "means": "the branch checked out"}}}}]}
"| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| branch | Text | 1 | stored | held | `worktree branch` | the branch checked out |\n| kind | enum(main, linked) | 1..* | stored | planned |  | which |\n| owner | Person | 0..1 | stored | planned |  |  |\n| path | Path | 1 | derived | held | `work path` | derived from the git dir. |\n| tags | Text | 0..* | stored | unused |  | a \\| b c |"

# a derived field with a means has both, and an entity with no fields has the header and the separator only
import "model" as model; model::build | [model::fields("A"), model::fields("B")]
{"files": [{"domain": "code", "origin": "release", "path": "a.yml", "doc": {"entity": "A", "layer": "logical", "fields": {"x": {"type": "Int", "source": "derived", "from": "y", "means": "the count"}}}}, {"domain": "code", "origin": "release", "path": "b.yml", "doc": {"entity": "B", "layer": "logical"}}]}
["| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| x | Int | 1 | derived |  |  | derived from y. the count |", "| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |"]

# a sum prints its variants, by variant then field, and a stub prints one line
import "model" as model; model::build | [model::fields("Head"), model::fields("Service")]
{"files": [{"domain": "git", "origin": "release", "path": "h.yml", "doc": {"entity": "Head", "layer": "logical", "sum": true, "variants": {"OnBranch": {"branch": "Branch", "since": "Commit"}, "Detached": {"commit": "Commit"}}}}, {"domain": "platform", "origin": "release", "path": "s.yml", "doc": {"entity": "Service", "stub": true}}]}
["| Variant | Field | Type |\n| --- | --- | --- |\n| Detached | commit | Commit |\n| OnBranch | branch | Branch |\n| OnBranch | since | Commit |", "_Service is a stub: named, not yet unpacked._"]

# a domain's relations are a table, by entity then relation: a one-to-one, a self-relation with an ordered many, a derived
# relation, and a stub's relation; another domain's entity is left out
import "model" as model; model::build | model::relations("code")
{"files": [{"domain": "code", "origin": "release", "path": "c.yml", "doc": {"entity": "Commit", "layer": "logical", "relations": {"parents": {"to": "Commit", "arity": "many", "ordered": true, "inverse": "Commit.children"}, "children": {"to": "Commit", "arity": "many", "inverse": "Commit.parents"}}}}, {"domain": "code", "origin": "release", "path": "h.yml", "doc": {"entity": "Head", "layer": "logical", "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head", "means": "whose head"}}}}, {"domain": "code", "origin": "release", "path": "w.yml", "doc": {"entity": "Worktree", "layer": "logical", "relations": {"head": {"to": "Head", "inverse": "Head.worktree"}, "commits": {"to": "Commit", "arity": "some", "derived": "the commits reachable from head"}}}}, {"domain": "code", "origin": "release", "path": "s.yml", "doc": {"entity": "Service", "stub": true, "relations": {"commit": {"to": "Commit", "arity": "option", "inverse": "Commit.service"}}}}, {"domain": "git", "origin": "release", "path": "g.yml", "doc": {"entity": "Branch", "layer": "logical", "relations": {"tip": {"to": "Commit", "inverse": "Commit.branch"}}}}]}
"| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |\n| Commit.children | Commit | 0..* |  | Commit.parents |  |\n| Commit.parents | Commit | 0..* | ordered | Commit.children |  |\n| Head.worktree | Worktree | 1 |  | Worktree.head | whose head |\n| Service.commit | Commit | 0..1 |  | Commit.service |  |\n| Worktree.commits | Commit | 1..* |  | derived | derived: the commits reachable from head |\n| Worktree.head | Head | 1 |  | Head.worktree |  |"

# a domain with no relations, or none at all, has the header and the separator only; a | in a relation's text is escaped
import "model" as model; model::build | [model::relations("empty"), model::relations("code")]
{"files": [{"domain": "code", "origin": "release", "path": "a.yml", "doc": {"entity": "A", "layer": "logical", "relations": {"r": {"to": "A", "derived": "a | b", "means": "x\ny"}}}}, {"domain": "empty", "origin": "release", "path": "e.yml", "doc": {"entity": "E", "layer": "logical"}}]}
["| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |", "| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |\n| A.r | A | 1 |  | derived | derived: a \\| b. x y |"]

# ----------------------------------------------------------------------------------------------------------------------
# page
# ----------------------------------------------------------------------------------------------------------------------

# a domain's page is its intro, its diagram, its relations table, and an entity section by name: a native entity with a
# held and a derived field and its tool, a logical one with what it is over, a sum with its variants, and a stub with
# the line that says it is one; another domain's entity is left out
import "model" as model; model::build | model::page("lab")
{"files": [{"domain": "lab", "origin": "release", "path": "m/lab/domain.yml", "doc": {"name": "Lab", "intro": "The things of the lab."}}, {"domain": "lab", "origin": "release", "path": "c.yml", "doc": {"entity": "Commit", "layer": "native", "tool": "git", "means": "A commit.", "fields": {"id": {"type": "Hash", "status": "held", "read-by": "commit id", "means": "its name"}, "size": {"type": "Int", "source": "derived", "from": "the tree", "status": "planned"}}, "relations": {"head": {"to": "Head", "inverse": "Head.commit"}}}}, {"domain": "lab", "origin": "release", "path": "w.yml", "doc": {"entity": "Worktree", "layer": "logical", "over": ["Commit", "git worktree"], "means": "A checked-out tree.", "relations": {"head": {"to": "Head", "inverse": "Head.worktree"}}}}, {"domain": "lab", "origin": "release", "path": "h.yml", "doc": {"entity": "Head", "layer": "logical", "sum": true, "over": [], "means": "Where a worktree stands.", "variants": {"Detached": {"commit": "Commit"}}, "relations": {"commit": {"to": "Commit", "inverse": "Commit.head"}, "worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}}, {"domain": "lab", "origin": "release", "path": "s.yml", "doc": {"entity": "Service", "stub": true, "means": "A service."}}, {"domain": "other", "origin": "release", "path": "o.yml", "doc": {"entity": "Other", "layer": "logical", "means": "Elsewhere."}}]}
"The things of the lab.\n\n![Lab: the entities of the domain and how they relate](lab.svg)\n\n## Relations\n\n| Relation | To | Arity | Ordered | Inverse | Means |\n| --- | --- | --- | --- | --- | --- |\n| Commit.head | Head | 1 |  | Head.commit |  |\n| Head.commit | Commit | 1 |  | Commit.head |  |\n| Head.worktree | Worktree | 1 |  | Worktree.head |  |\n| Worktree.head | Head | 1 |  | Head.worktree |  |\n\n## Entities\n\n### Commit\n\nA commit.\n\nLayer: native (git)\n\n| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |\n| id | Hash | 1 | stored | held | `commit id` | its name |\n| size | Int | 1 | derived | planned |  | derived from the tree. |\n\n### Head\n\nWhere a worktree stands.\n\nLayer: logical\n\n| Variant | Field | Type |\n| --- | --- | --- |\n| Detached | commit | Commit |\n\n### Service\n\nA service.\n\nStub: named so other entities can refer to it; its fields are not modelled.\n\n### Worktree\n\nA checked-out tree.\n\nLayer: logical over Commit, git worktree\n\n| Field | Type | Arity | Source | Status | Read by | Means |\n| --- | --- | --- | --- | --- | --- | --- |"

# a domain with no entities has its intro, its diagram, and its two sections with nothing under them, and no blank line at
