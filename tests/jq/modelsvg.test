# a label that no place keeps clear is still drawn, and render names its entity as crowded: thirty lines from A to B
import "modelsvg" as modelsvg; {domains: {}, entities: {A: {domain: "crowd", layer: "logical", relations: ([range(0; 30) | {key: "toward\(.)", value: {to: "B", derived: "x"}}] | from_entries)}, B: {domain: "crowd", layer: "logical"}}, findings: []} | modelsvg::render("crowd") | [.crowded, ([.svg | scan("<path class=\"edge")] | length), ([.svg | scan("<text class=\"lbl\"")] | length)]
