# no label of the lab domain overlaps another label or a card
import "modelsvg" as modelsvg; modelsvg::layout("lab") as $l | modelsvg::edges("lab") | [.labels[].box] as $boxes | ([$l.cards[] | [.x, .y, .x + .w, .y + .h]]) as $cards | [range(0; $boxes | length) as $i | $boxes[$i] as $a | ($boxes[$i + 1:] + $cards)[] | select($a[0] < .[2] and .[0] < $a[2] and $a[1] < .[3] and .[1] < $a[3])] | length
