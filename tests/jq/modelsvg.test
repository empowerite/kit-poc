# no line ends at, on, or within 4 of another line, where it would seem to go on past its card, or an arrowhead would
# touch the other line
import "modelsvg" as modelsvg; modelsvg::edges("lab") | [.paths[] as $p | $p.points | range(1; length) as $i | {key: $p.key, s: [.[$i - 1], .[$i]]}] as $segs | [.paths[] | {key, at: (.points[0], .points[-1])} | . as $e | $segs[] | select(.key != $e.key) | select(([0, ([.s[][0]] | min) - $e.at[0], $e.at[0] - ([.s[][0]] | max)] | max) < 4 and ([0, ([.s[][1]] | min) - $e.at[1], $e.at[1] - ([.s[][1]] | max)] | max) < 4) | [$e.key, .key]] | unique
