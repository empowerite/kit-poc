# a label belongs to its end: the text of each label is within 40 of the end of its line, in x and in y
import "modelsvg" as modelsvg; modelsvg::edges("lab") | (.paths | map({key: .key, value: .points}) | from_entries) as $p | [.labels[] | (if .role == "a" then $p[.key][0] else $p[.key][-1] end) as $e | select(([0, .box[0] - $e[0], $e[0] - .box[2]] | max) > 40 or ([0, .box[1] - $e[1], $e[1] - .box[3]] | max) > 40) | [.key, .text]]
