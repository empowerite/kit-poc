# The cases below share a fifth model, built from tests/fixtures/model/st/release: card S carries twelve ends on its
# right side, four loops and four stubs, so its row must grow to hold their labels apart; P0 and P1 send derived lines
# down a column of nine cards.

# no label of the stress model overlaps another label or a card
import "modelsvg" as modelsvg; modelsvg::layout("st") as $l | modelsvg::edges("st") | [.labels[].box] as $boxes | ([$l.cards[] | [.x, .y, .x + .w, .y + .h]]) as $cards | [range(0; $boxes | length) as $i | $boxes[$i] as $a | ($boxes[$i + 1:] + $cards)[] | select($a[0] < .[2] and .[0] < $a[2] and $a[1] < .[3] and .[1] < $a[3])] | length
