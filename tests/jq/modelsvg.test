# The cases below share a second model: the org domain holds Org, Person, and Team (a sum, hinted at row 1, column 1);
# User, of the other domain, owns an Org. Org.parent and Org.children are a pair on one entity, Person.friends is its
# own inverse, Person.mentor and Person.team are derived, and Person.pal names an inverse that does not exist.

# a pair of inverse relations is one line, with markers at both ends; a relation to itself is a loop, a derived one is
# dashed, one with no inverse to pair with is an arrow, and one to another domain's entity is a stub
import "modelsvg" as modelsvg; modelsvg::edges("org") | [.paths[] | [.key, .kind, .class]]
{"domains": {"org": {"name": "Org", "layout": {"Team": {"row": 1, "col": 1}}}}, "entities": {"Org": {"domain": "org", "layer": "logical", "means": "an organization", "relations": {"parent": {"to": "Org", "arity": "option", "inverse": "Org.children"}, "children": {"to": "Org", "arity": "many", "ordered": true, "inverse": "Org.parent"}, "members": {"to": "Person", "arity": "some", "inverse": "Person.org"}, "staff": {"to": "Person", "arity": "many", "inverse": "Person.boss"}, "owner": {"to": "User", "inverse": "User.orgs"}}}, "Person": {"domain": "org", "layer": "logical", "means": "a person", "relations": {"org": {"to": "Org", "inverse": "Org.members"}, "boss": {"to": "Org", "arity": "option", "inverse": "Org.staff"}, "friends": {"to": "Person", "arity": "many", "inverse": "Person.friends"}, "mentor": {"to": "Person", "arity": "option", "derived": "the lead of the person's team"}, "team": {"to": "Team", "derived": "the team the person's org gives"}, "pal": {"to": "Org", "inverse": "Org.nothing"}}}, "Team": {"domain": "org", "layer": "logical", "sum": true, "variants": {"Small": {"lead": "Person"}, "Large": {"org": "Org"}}}, "User": {"domain": "other", "layer": "logical", "relations": {"orgs": {"to": "Org", "arity": "many", "inverse": "Org.owner"}}}}, "findings": []}
[["Org.children", "loop", "edge both"], ["Org.members", "line", "edge both"], ["Org.owner", "stub", "edge"], ["Org.staff", "line", "edge both"], ["Person.friends", "loop", "edge both"], ["Person.mentor", "loop", "edge dash"], ["Person.pal", "line", "edge"], ["Person.team", "line", "edge dash"]]

# at the end of a line at B goes the name and arity of A's relation to B, and at A's end those of B's relation to A;
# ordered adds {ordered}, a derived relation derived, and a stub's label names the other entity
import "modelsvg" as modelsvg; modelsvg::edges("org") | [.labels[] | [.key, .at, .text, .far]]
