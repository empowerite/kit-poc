# the overview puts five panels in a row, the sixth starts the next, and the panels of a row are as tall as its tallest
import "modelsvg" as modelsvg; modelsvg::panels | map_values([.x, .row]) , (to_entries | map(select(.value.row == 0) | .value.h) | unique | length)
