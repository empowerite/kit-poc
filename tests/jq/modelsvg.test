# a label sits at its own end of its line, beside the leg the line runs straight from that end, within 8 of it: the first
# leg for A's end, the last for B's end, and a stub's one leg, by its tip
import "modelsvg" as modelsvg; modelsvg::edges("org") | (.paths | map({key: .key, value: .points}) | from_entries) as $p | [.labels[] | $p[.key] as $pts | (if .role == "a" then $pts[0:2] else $pts[-2:] end) as $leg | [([$leg[][0]] | min), ([$leg[][1]] | min), ([$leg[][0]] | max), ([$leg[][1]] | max)] as $l | .box as $b | ([0, $l[0] - $b[2], $b[0] - $l[2]] | max) <= 8 and ([0, $l[1] - $b[3], $b[1] - $l[3]] | max) <= 8] | all
