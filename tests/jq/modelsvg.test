{"domains": {"d": {"layout": {"A": {"row": 0, "col": 0}, "B": {"row": 0, "col": 1}, "C": {"row": 0, "col": 2}, "D": {"row": 1, "col": 2}, "E": {"row": 1, "col": 1}}}}, "entities": {"A": {"domain": "d"}, "B": {"domain": "d", "relations": {"self": {"to": "B", "arity": "many", "inverse": "B.self"}}}, "C": {"domain": "d"}, "D": {"domain": "d"}, "E": {"domain": "d", "relations": {"self": {"to": "E", "arity": "many", "inverse": "E.self"}}}}, "findings": []}
[["B.self", 568, 14, 0], ["E.self", 568, 14, 0], true]

# The cases below share a third model, built from tests/fixtures/model/lab/release: the lab domain holds eleven entities
# with no layout hints, pairs between cards several rows apart, pairs on one entity, a relation that is its own inverse,
# derived relations into a sum and into a stub, an inverse that names nothing back, and relations to the far domain.

# no segment of a line passes through a card: a line meets its own two cards only at their edges
import "modelsvg" as modelsvg; modelsvg::layout("lab").cards as $c | modelsvg::edges("lab") | [.paths[] as $p | $p.points | range(1; length) as $i | [.[$i - 1], .[$i]] as $s | $c | to_entries[] | .value as $k | select(([$s[0][0], $s[1][0]] | min) < $k.x + $k.w and ([$s[0][0], $s[1][0]] | max) > $k.x and ([$s[0][1], $s[1][1]] | min) < $k.y + $k.h and ([$s[0][1], $s[1][1]] | max) > $k.y) | [$p.key, .key]]
{"domains":{"lab":{"name":"Lab & \"Co\"","intro":"A realistic domain <of> eleven entities, with pairs, loops, a sum, a stub, and a way out."}},"entities":{"Forge":{"domain":"far","origin":"release","layer":"logical","means":"a code host","relations":{"repos":{"to":"Repo","arity":"many","inverse":"Repo.forge"}}},"Person":{"domain":"far","origin":"release","layer":"logical","means":"a human"},"Agent":{"domain":"lab","origin":"release","layer":"logical","means":"who works","relations":{"leases":{"to":"Lease","arity":"many","inverse":"Lease.holder"},"friends":{"to":"Agent","arity":"many","inverse":"Agent.friends"}}},"Branch":{"domain":"lab","origin":"release","layer":"native","tool":"git","means":"a named line of commits","fields":{"name":{"type":"Text","status":"planned"}},"relations":{"repo":{"to":"Repo","inverse":"Repo.branches"},"upstream":{"to":"Branch","arity":"option","inverse":"Branch.downstream"},"downstream":{"to":"Branch","arity":"many","inverse":"Branch.upstream"},"tip":{"to":"Commit","inverse":"Commit.branches"}}},"Commit":{"domain":"lab","origin":"release","layer":"native","tool":"git","means":"a snapshot","fields":{"sha":{"type":"Hash","status":"held","read-by":"log sha"}},"relations":{"branches":{"to":"Branch","arity":"many","inverse":"Branch.tip"},"parents":{"to":"Commit","arity":"many","ordered":true,"inverse":"Commit.children"},"children":{"to":"Commit","arity":"many","inverse":"Commit.parents"},"author":{"to":"Person","derived":"the author line"}}},"Ghost":{"domain":"lab","origin":"release","stub":true,"means":"named so others can refer to it"},"Head":{"domain":"lab","origin":"release","layer":"logical","sum":true,"means":"what the worktree has checked out","variants":{"Attached":{"branch":"Branch"},"Detached":{"commit":"Commit"}}},"Lease":{"domain":"lab","origin":"release","layer":"logical","over":["Worktree","Agent"],"means":"a claim on a worktree by an agent","relations":{"worktree":{"to":"Worktree","inverse":"Worktree.lease"},"holder":{"to":"Agen