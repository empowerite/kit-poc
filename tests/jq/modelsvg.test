# modelsvg.test - the modelsvg jq module, run by jq -L kit/modules/jq --run-tests
#
# Each case is a program, an input, and the outputs it gives, one JSON value per line, then a blank line. An input is
# what model::build gives: {domains, entities, findings}. Most cases share one model: the code domain holds Worktree,
# Repository (hinted at row 0, column 0), Head (a sum), Branch, and Ghost (a stub); actors holds Person.

# layout puts a hinted card where its hint says, and the rest by layering: Head and Worktree need each other, so the
# cycle breaks by name and Worktree goes one column right of Head; Branch, Ghost, and Head go below Repository, the
# hinted card of their column, by name
import "modelsvg" as modelsvg; modelsvg::layout("code") | .cards | map_values([.row, .col])
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
{"Branch": [1, 0], "Ghost": [2, 0], "Head": [3, 0], "Repository": [0, 0], "Worktree": [0, 1]}

# a card is 236 wide, columns are 64 apart, rows 56 apart, and the cards of a row are as tall as its tallest; the first
# row starts under the title and the one line of intro
import "modelsvg" as modelsvg; modelsvg::layout("code") | .cards | [.Branch.x, .Worktree.x, .Worktree.w, .Repository.y, .Branch.y == .Repository.y + .Repository.h + 56, .Repository.h == .Worktree.h]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[32, 332, 236, 103, true, true]

# an entity no hint places goes one column right of the deepest entity that needs it, over one and some, not many or
# option; a chain A needs B needs C, and A needs C, puts C two columns right of A
import "modelsvg" as modelsvg; modelsvg::layout("d") | .cards | map_values([.row, .col])
{"domains": {}, "entities": {"C": {"domain": "d", "layer": "logical"}, "B": {"domain": "d", "layer": "logical", "relations": {"c": {"to": "C", "arity": "some"}}}, "A": {"domain": "d", "layer": "logical", "relations": {"b": {"to": "B"}, "c": {"to": "C"}, "d": {"to": "D", "arity": "many"}, "e": {"to": "E", "arity": "option"}}}, "D": {"domain": "d", "layer": "logical"}, "E": {"domain": "d", "layer": "logical"}}, "findings": []}
{"A": [0, 0], "B": [0, 1], "C": [0, 2], "D": [1, 0], "E": [2, 0]}

# a cycle of three ends: the edge back into an entity on the current path, taken in name order, is not followed
import "modelsvg" as modelsvg; modelsvg::layout("d") | .cards | map_values([.row, .col])
{"domains": {}, "entities": {"C": {"domain": "d", "relations": {"a": {"to": "A"}}}, "B": {"domain": "d", "relations": {"c": {"to": "C"}}}, "A": {"domain": "d", "relations": {"b": {"to": "B"}}}}, "findings": []}
{"A": [0, 0], "B": [0, 1], "C": [0, 2]}

# two hints for one cell: the second by name moves down to the next free row; a row and a column no card holds close
# up, and a hint that is not two numbers of zero or more counts as none
import "modelsvg" as modelsvg; modelsvg::layout("d") | .cards | map_values([.row, .col])
{"domains": {"d": {"layout": {"A": {"row": 2, "col": 4}, "B": {"row": 2, "col": 4}, "C": {"row": -1, "col": 0}, "Z": {"row": 0, "col": 0}}}}, "entities": {"A": {"domain": "d"}, "B": {"domain": "d"}, "C": {"domain": "d"}}, "findings": []}
{"A": [1, 1], "B": [2, 1], "C": [0, 0]}

# a domain's diagram has a card for every entity of the domain, and none for another domain's
import "modelsvg" as modelsvg; modelsvg::domain("code") | [scan("<text class=\"h\"[^>]*>([^<]*)</text>")[0]] | sort
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
["Branch", "Ghost", "Head", "Repository", "Worktree"]

# a domain's diagram is one svg element with a title and a desc, every text element closed, and every & an entity
import "modelsvg" as modelsvg; modelsvg::domain("code") | [startswith("<svg xmlns=\"http://www.w3.org/2000/svg\""), endswith("</svg>"), ([scan("<text[ >]")] | length) == ([scan("</text>")] | length), test("<title id=\"title\">Code</title>"), test("<desc id=\"desc\">Entities of the Code domain: Branch, Ghost, Head, Repository, and Worktree\\.</desc>"), (test("&(?!(amp|lt|gt|quot|apos);)") | not)]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, true, true, true, true]

# a native card says native: and its tool, a logical card logical and what it is over, and a card that is neither a
# sum nor a stub counts its fields by status
import "modelsvg" as modelsvg; modelsvg::domain("code") | [test(">native: git</text>"), test(">logical</text>"), test(">over: Remote, Checkout</text>"), test(">1 held, 1 planned, 1 unused</text>"), test(">0 held, 1 planned, 0 unused</text>"), test(">0 held, 0 planned, 0 unused</text>"), ([scan(" held, ")] | length)]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, true, true, true, true, 3]

# a sum lists its variants, one a line, by name, each with its fields
import "modelsvg" as modelsvg; .entities.Head.domain = "solo" | modelsvg::domain("solo") | [scan("<text class=\"m\"[^>]*>([^<]*)</text>")[0]]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
["Attached(branch: Branch)", "Detached(commit: Commit)"]

# a stub is dashed, grey, and has no footer, so its domain's diagram has no dot and no legend
import "modelsvg" as modelsvg; .entities.Ghost.domain = "solo" | modelsvg::domain("solo") | [test("stroke=\"#94a3b8\" stroke-width=\"1.5\" stroke-dasharray=\"6 4\""), test("fill=\"#f1f5f9\""), test("<circle")]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, false]

# the footer dot is green when a field is held, and hollow when none is; the legend has one of each, and the footer
# names the verbs that read the held fields
import "modelsvg" as modelsvg; [(.entities.Worktree.domain = "solo" | modelsvg::domain("solo")), (.entities.Repository.domain = "solo" | modelsvg::domain("solo"))] | map([([scan("fill=\"#16a34a\"")] | length), ([scan("fill=\"#ffffff\" stroke=\"#94a3b8\"")] | length), test(">kit work</text>"), test("class=\"f\"[^>]*>not held yet</text>")])
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[[2, 1, true, false], [1, 2, false, true]]

# a card's header takes its domain's tint, stroke, and dark text color
import "modelsvg" as modelsvg; .entities.Branch.domain = "solo" | modelsvg::domain("code") | [test("fill=\"#dcfce7\""), test("stroke=\"#15803d\""), test("style=\"fill:#14532d\">Worktree<")]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, true]

# the release's domains have fixed colors, and config and configuration share one; any other domain takes one of six
# by its place among the sorted domain names: actors, alpha, code, zeta gives alpha the second and zeta the fourth
import "modelsvg" as modelsvg; .entities.Ghost.domain = "zeta" | .entities.Branch.domain = "alpha" | [modelsvg::colour("code"), modelsvg::colour("config") == modelsvg::colour("configuration"), modelsvg::colour("alpha"), modelsvg::colour("zeta")]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[{"tint": "#dcfce7", "stroke": "#15803d", "dark": "#14532d"}, true, {"tint": "#cffafe", "stroke": "#0e7490", "dark": "#164e63"}, {"tint": "#fef9c3", "stroke": "#a16207", "dark": "#713f12"}]

# a name, a means, and an intro with <, &, and quotes are escaped, so the diagram stays well-formed
import "modelsvg" as modelsvg; .domains.code.intro = "a <b> & \"c\"" | .entities["A<&\"b"] = {"domain": "code", "layer": "logical", "means": "x < y & 'z'"} | modelsvg::domain("code") | [test(">A&lt;&amp;&quot;b<"), test(">x &lt; y &amp; &apos;z&apos;<"), test(">a &lt;b&gt; &amp; &quot;c&quot;<"), test("x < y"), (test("&(?!(amp|lt|gt|quot|apos);)") | not)]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, true, false, true]

# a long means wraps to the card's width; a word wider than the card breaks; a name wider than the band is set smaller
import "modelsvg" as modelsvg; .entities.Branch.means = "one two three four five six seven eight nine ten eleven twelve" | .entities.Branch.domain = "solo" | .entities.Ghost.domain = "solo" | .entities.Ghost.means = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" | .entities.ThisIsAVeryLongEntityNameIndeed = {"domain": "solo", "layer": "logical"} | modelsvg::domain("solo") | [([scan("<text class=\"w\"[^>]*>([^<]*)</text>")[0]] | [length == 4, all(.[]; modelsvg::width(12.5) <= 212)]), test("font-size:[0-9.]+px\">ThisIsAVeryLongEntityNameIndeed<")]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[[true, true], true]

# every number is printed with at most one decimal
import "modelsvg" as modelsvg; [modelsvg::domain("code"), modelsvg::overview] | map(test("[0-9]\\.[0-9]{2,}") | not)
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true]

# num prints a number rounded to one decimal, with no trailing zero and no float noise
import "modelsvg" as modelsvg; [0.1 * 3, 2.25, 12, -0.04, -7.36, 1234.56] | map(modelsvg::num)
null
["0.3", "2.3", "12", "0", "-7.4", "1234.6"]

# the output is the same on a second run, and whatever order the model's objects hold their keys in
import "modelsvg" as modelsvg; [modelsvg::domain("code") == modelsvg::domain("code"), modelsvg::domain("code") == (.entities |= (to_entries | reverse | from_entries) | .entities.Worktree.fields |= (to_entries | reverse | from_entries) | modelsvg::domain("code")), modelsvg::overview == (.entities |= (to_entries | reverse | from_entries) | modelsvg::overview)]
{"domains": {"code": {"name": "Code", "intro": "What git holds.", "layout": {"Repository": {"row": 0, "col": 0}}}}, "entities": {"Worktree": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a linked worktree", "fields": {"path": {"type": "Path", "status": "held", "read-by": "work path"}, "name": {"type": "Text", "status": "planned"}, "slot": {"type": "Int", "status": "unused"}}, "relations": {"repository": {"to": "Repository", "inverse": "Repository.worktrees"}, "head": {"to": "Head", "inverse": "Head.worktree"}}}, "Repository": {"domain": "code", "origin": "release", "layer": "logical", "over": ["Remote", "Checkout"], "means": "a repository", "fields": {"url": {"type": "Url", "status": "planned"}}, "relations": {"worktrees": {"to": "Worktree", "arity": "many", "inverse": "Worktree.repository"}}}, "Head": {"domain": "code", "origin": "release", "layer": "logical", "sum": true, "means": "what a worktree has checked out", "variants": {"Detached": {"commit": "Commit"}, "Attached": {"branch": "Branch"}}, "relations": {"worktree": {"to": "Worktree", "inverse": "Worktree.head"}}}, "Branch": {"domain": "code", "origin": "release", "layer": "native", "tool": "git", "means": "a branch", "fields": {}}, "Ghost": {"domain": "code", "origin": "release", "stub": true, "means": "named only"}, "Person": {"domain": "actors", "origin": "release", "layer": "logical", "means": "a person"}}, "findings": []}
[true, true, true]

# a domain with no entity is a diagram with its title and no card
import "modelsvg" as modelsvg; modelsvg::domain("empty") | [test("<title id=\"title\">Empty</title>"), test("class=\"h\""), test("The Empty domain holds no entity\\.")]
{"domains": {"empty": {"name": "Empty"}}, "entities": {}, "findings": []}
[true, false, true]

# the overview has a panel for each domain, a domain.yml's or an entity's, by name, with the domain's name, its intro,
# and its entities as pills; a stub's pill is dashed
import "modelsvg" as modelsvg; modelsvg::overview | [([scan("<text class=\"p\"[^>]*>([^<]*)</text>")[0]]), ([scan("<text class=\"h\"[^>]*>([^<]*)</text>")[0]]), test(">What git holds.</text>"), test("stroke-dasharray=\"4 3\"[^\\n]*\\n[^\\n]*>Ghost<")]
