# the canvas of the lab diagram holds every point of every line and every label
import "modelsvg" as modelsvg; (modelsvg::domain("lab") | capture("viewBox=\"0 0 (?<w>[0-9.]+) (?<h>[0-9.]+)\"") | map_values(tonumber)) as $v | modelsvg::edges("lab") | [(.paths[].points[]), (.labels[].box | .[0:2], .[2:4]) | select(.[0] < 0 or .[1] < 0 or .[0] > $v.w or .[1] > $v.h)]
