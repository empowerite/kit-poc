# The cases below share a fourth model, built from tests/fixtures/model/col/release: nine hinted cards in one column,
# with twelve lines that cross the gutter right of it, which must widen to hold them 6 apart.

# parallel segments of two column lines that run beside each other are at least 6 apart
import "modelsvg" as modelsvg; modelsvg::edges("col") | [.paths[] as $p | $p.points | range(1; length) as $i | {key: $p.key, s: [.[$i - 1], .[$i]]}] as $segs | [range(0; $segs | length) as $i | range($i + 1; $segs | length) as $j | $segs[$i] as $a | $segs[$j] as $b | select($a.key != $b.key) | select(($a.s[0][0] == $a.s[1][0] and $b.s[0][0] == $b.s[1][0] and ($a.s[0][0] - $b.s[0][0] | fabs) < 6 and ([$a.s[][1]] | min) < ([$b.s[][1]] | max) and ([$b.s[][1]] | min) < ([$a.s[][1]] | max)) or ($a.s[0][1] == $a.s[1][1] and $b.s[0][1] == $b.s[1][1] and ($a.s[0][1] - $b.s[0][1] | fabs) < 6 and ([$a.s[][0]] | min) < ([$b.s[][0]] | max) and ([$b.s[][0]] | min) < ([$a.s[][0]] | max))) | [$a.key, $b.key]] | unique
