# every lab label is at least 3 from every line but its own, so its halo cuts no other line
import "modelsvg" as modelsvg; modelsvg::edges("lab") | [.paths[] as $p | $p.points | range(1; length) as $i | {key: $p.key, s: [.[$i - 1], .[$i]]}] as $segs | [.labels[] as $l | $segs[] | select(.key != $l.key) | select(([.s[][0]] | min) - 3 < $l.box[2] and $l.box[0] < ([.s[][0]] | max) + 3 and ([.s[][1]] | min) - 3 < $l.box[3] and $l.box[1] < ([.s[][1]] | max) + 3) | [$l.key, $l.text, .key]] | unique
